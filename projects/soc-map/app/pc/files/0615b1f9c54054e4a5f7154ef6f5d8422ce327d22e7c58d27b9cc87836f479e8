# ───────────────────────── 현장 경보 ─────────────────────────
WATCH_SEC = 10 * 60      # 확인 주기 — 실제로 기상청에 묻는 것은 새 발표가 있을 때뿐(_cached)


def _signature(w):
    """화면에 다시 보낼 만큼 바뀌었나 — 발표 시각과 판정"""
    return (tuple(sorted((w.get("base") or {}).items())), tuple((c["id"], c["status"]) for c in w.get("checks", [])))


async def background():
    """접속한 사람이 있는 현장마다 10분에 한 번 확인 → 새 발표가 있거나 판정이 바뀌었을 때만 관리자·관리감독자에게 보내고,
    법정 기준을 새로 넘거나(지금) 넘을 예보(6시간)가 나오면 경보 기록에 남긴다"""
    if not CONF:
        return
    while True:
        await asyncio.sleep(30)
        for p in list(projects.store.projects.values()):
            if not (p.managers or p.client_ws):
                continue
            if time.time() - getattr(p, "weather_at", 0) < WATCH_SEC:
                continue
            p.weather_at = time.time()
            o = p.meta["origin"]
            try:
                w = await asyncio.to_thread(get, o["lat"], o["lon"])
            except KmaError as e:
                log.warning(f"[{p.meta['name']}] 날씨 실패: {e}")
                continue
            except Exception:
                log.exception("날씨 처리 오류")
                continue
            p.weather = w
            sig = _signature(w)
            if sig == getattr(p, "weather_sig", None):
                continue
            p.weather_sig = sig
            await p.to_managers({"type": "weather", "weather": w})
            await weather_events(p, w)


async def weather_events(p, w):
    prev = getattr(p, "weather_state", {})
    state = {}
    for c in w["checks"]:
        state[c["id"]] = c["status"]
        if c["status"] in ("warn", "stop") and RANK[c["status"]] > RANK.get(prev.get(c["id"], "ok"), 0):
            await p.event("weather", None, f"🌦️ 기상청: {c['text']} ({c['law']})", "warning", check=c["id"], status=c["status"])
    p.weather_state = state
