class Project:
    def __init__(self, meta):
        self.meta = meta
        self.id = meta["id"]
        self.dir = os.path.join(ROOT, self.id)
        self.frame = LocalFrame(meta["origin"]["lat"], meta["origin"]["lon"])
        self.site = self._read_json("site.json")
        self.survey = self._read_json("survey.json") or []
        self.places = self._read_json("places.json") or []
        self.push_subs = self._read_json("push.json") or []
        self.push_lock = threading.Lock()
        self.clients = {}        # id → 상태
        self.client_ws = {}      # id → WebSocket
        self.managers = set()
        self.events = []
        self.peers_dirty = True
        self.evac = None                   # 2026-11-22 대피 점호 (fieldops.Evac)
        self.outside_pos = {}              # 2026-11-24 현장 밖 사람의 마지막 위치 — 공유하지 않고 긴급 호출 때만 씀
        self.corr = fieldops.RefCorr()     # 2026-11-22 기준점 보정
        self._corr_sent = 0
        if os.path.exists(self._path("attendance.jsonl")):   # 서버가 다시 켜짐 → 지난 접속 구간은 마지막으로 본 시각에서 끊는다
            report.append_jsonl(self._path("attendance.jsonl"), {"ts": time.time(), "kind": "reset"})

    # ── 파일 ──
    def _path(self, name):
        return os.path.join(self.dir, name)

    def _read_json(self, name):
        try:
            with open(self._path(name), encoding="utf-8") as f:
                return json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            return None

    def _write_json(self, name, data):
        os.makedirs(self.dir, exist_ok=True)
        tmp = self._path(name + ".tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, self._path(name))

    def save_meta(self):
        self._write_json("project.json", self.meta)

    def public(self, manager=False):
        out = {k: v for k, v in self.meta.items() if k not in ("manager_key_sha256", "join_code")}
        out["online"] = sum(1 for c in self.clients.values() if c.get("online"))
        out["site_version"] = (self.site or {}).get("version", 0)
        out["policy"] = self.policy
        if manager:
            out["join_code"] = self.meta["join_code"]
            out["push_count"] = len(self.push_subs)
        return out

    @property
    def policy(self):
        return {**DEFAULT_POLICY, **(self.meta.get("policy") or {})}

    def check_manager(self, key):
        return bool(key) and secrets.compare_digest(_hash(key), self.meta["manager_key_sha256"])

    @property
    def gps_join(self):
        return self.meta.get("gps_join", True)

    def site_distance(self, lat, lon):
        """위경도에서 현장까지 거리(m). 현장 경계가 있으면 경계까지, 배치를 공유했으면 배치 범위 사각형까지, 아니면 원점까지"""
        x, y = self.frame.to_local(lat, lon)
        b = ((self.site or {}).get("doc") or {}).get("siteBoundary")
        if isinstance(b, list) and len(b) >= 6:
            return polygon_distance(x, y, b)
        ext = (self.site or {}).get("extent")
        if ext:
            dx = max(ext["minX"] - x, 0.0, x - ext["maxX"])
            dy = max(ext["minY"] - y, 0.0, y - ext["maxY"])
            return math.hypot(dx, dy)
        return math.hypot(x, y)

    def check_code(self, code):
        return bool(code) and secrets.compare_digest(code.strip().upper(), self.meta["join_code"])

    # ── 좌표 ──
    def locate(self, c, msg):
        """보고된 위치를 프로젝트 좌표로. 위경도가 있으면 서버가 직접 변환(권위 있는 값)"""
        lat, lon = msg.get("lat"), msg.get("lon")
        if lat is not None and valid_latlon(lat, lon):
            c["lat"], c["lon"] = float(lat), float(lon)
            x, y = self.frame.to_local(c["lat"], c["lon"])
            c["x"], c["y"] = round(x, 2), round(y, 2)
        elif isinstance(msg.get("x"), (int, float)) and isinstance(msg.get("y"), (int, float)):
            c["x"], c["y"] = round(float(msg["x"]), 2), round(float(msg["y"]), 2)   # 시연 모드
            c["lat"], c["lon"] = self.frame.to_latlon(c["x"], c["y"])
        if "x" in c and (lat is not None or "x" in msg):
            c["pos_ts"] = time.time()
        if "x" in c and c.get("x") is not None and self.site:
            # 2026-11-24 현장 경계(+30 m) — 앱(costmap.js siteContains)과 같은 규칙. 앱이 「안」(위험 구역 20 m 안)이라고 하면 안
            c["inside_site"] = site_inside(self.site, c["x"], c["y"]) or msg.get("inside") is True

    def trace(self, c, msg):
        """경보 현장 시험용 위치 보고 기록 (SOCMAP_TRACE=1 일 때만)"""
        if os.environ.get("SOCMAP_TRACE") != "1":
            return
        row = {"ts": time.time(), "client_id": c.get("id"), "name": c.get("name"), "role": c.get("role"),
               "x": c.get("x"), "y": c.get("y"), "lat": c.get("lat"), "lon": c.get("lon")}
        for k in ("acc", "sigma", "speed", "level", "raw_level", "risk", "nearest_m", "source", "raw_lat", "raw_lon", "client_ts", "intrusions"):
            if k in msg:
                row[k] = msg[k]
        if valid_latlon(msg.get("raw_lat"), msg.get("raw_lon")):
            rx, ry = self.frame.to_local(float(msg["raw_lat"]), float(msg["raw_lon"]))
            row["raw_x"], row["raw_y"] = round(rx, 2), round(ry, 2)
        try:
            os.makedirs(self.dir, exist_ok=True)
            with open(self._path("trace.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps(row, ensure_ascii=False) + "\n")
        except Exception:
            pass

    # ── 전송 ──
    async def to_managers(self, msg):
        for ws in list(self.managers):
            try:
                await ws.send_json(msg)
            except Exception:
                self.managers.discard(ws)

    async def to_client(self, cid, msg):
        ws = self.client_ws.get(cid)
        if not ws:
            return False
        try:
            await ws.send_json(msg)
            return True
        except Exception:
            return False

    async def to_clients(self, msg):
        for cid in list(self.client_ws):
            await self.to_client(cid, msg)

    def describe_location(self, x, y):
        """현장 좌표 → 사람이 읽는 위치 설명 (예: "102동 남쪽 8 m · 굴착기에서 6 m")
        건물 이름·대피 장소·장비(운전원 휴대폰 실시간 위치 우선)를 기준으로 삼는다"""
        doc = (self.site or {}).get("doc") or {}
        parts = []
        bdata = doc.get("buildingData") or {}
        best = None   # (거리, 이름, 가장 가까운 점)
        for i, c in enumerate(doc.get("contours") or []):
            poly = _flat_contour(c)
            if len(poly) < 3:
                continue
            name = (bdata.get(str(i)) or bdata.get(i) or {}).get("name") or f"건물 {i + 1}"
            if _point_in_poly(x, y, poly):
                best = (0.0, name, None)
                break
            d, q = _dist_to_poly(x, y, poly)
            if best is None or d < best[0]:
                best = (d, name, q)
        if best and best[0] == 0:
            parts.append(f"{best[1]} 안")
        elif best and best[0] <= 40:
            parts.append(f"{best[1]} {_compass(x - best[2][0], y - best[2][1])}쪽 {round(best[0])} m")
        live = {c.get("equipment"): (c.get("eq_x", c["x"]), c.get("eq_y", c["y"])) for c in self.clients.values()
                if c.get("role") == "operator" and c.get("online") and c.get("x") is not None}
        eq = None
        for m in doc.get("markers") or []:
            if not m.get("isEquipment"):
                continue
            ex, ey = live.get(m.get("id"), (m.get("x"), m.get("y")))
            if ex is None:
                continue
            d = math.hypot(x - ex, y - ey)
            if d <= 30 and (eq is None or d < eq[0]):
                eq = (d, m.get("label") or "장비")
        if eq:
            parts.append(f"{eq[1]}에서 {round(eq[0])} m")
        for pl in self.places:
            d = math.hypot(x - pl["x"], y - pl["y"])
            if d <= 25:
                parts.append(f"{pl['name']} 근처 {round(d)} m")
                break
        if not parts:
            parts.append(f"현장 원점에서 {_compass(x, y)}쪽 {round(math.hypot(x, y))} m")
        return " · ".join(parts)

    def equipment_label(self, mid):
        for m in ((self.site or {}).get("doc") or {}).get("markers", []):
            if m.get("id") == mid:
                return m.get("label") or "장비"
        return "장비 미지정" if not mid else "장비"

    def peers(self):
        keys = ("id", "name", "role", "equipment", "x", "y", "sigma", "heading", "level", "online", "sim", "speed", "vx", "vy", "op_state", "floor",
                "eq_x", "eq_y", "eq_heading", "work_x", "work_y")   # 2026-11-25 장비 자세(운전원이 내려 걸어도 장비는 그 자리) · 작업 위치
        return [{k: c.get(k) for k in keys} for c in self.clients.values() if c.get("x") is not None]

    def attend(self, c, kind, ts=None):
        """출입 기록 한 줄 (in 들어옴 · out 나감 · seen 5분마다 접속 중) — 하루 안전 기록의 출입 명부.
        사람마다 지금 상태(c["_att"])를 기억해 같은 것을 두 번 쓰지 않는다: 연결만 바꾼 휴대폰은 새 출입이 아니고,
        신호 끊김(30초 보고 없음)은 마지막 보고 시각으로 나감 → 다시 보고가 오면 들어옴"""
        now_in = c.get("_att") == "in"
        if (kind == "in" and now_in) or (kind in ("out", "seen") and not now_in):
            return
        if kind != "seen":
            c["_att"] = kind
        report.append_jsonl(self._path("attendance.jsonl"), {
            "ts": ts or time.time(), "kind": kind, "client_id": c.get("id"), "name": c.get("name"), "role": c.get("role"),
            "equipment": self.equipment_label(c.get("equipment")) if c.get("role") == "operator" else None,
            "sim": bool(c.get("sim"))})

    async def event(self, kind, c, text, severity="info", **extra):
        ev = {"id": secrets.token_hex(6), "ts": time.time(), "kind": kind, "severity": severity, "text": text,
              "client_id": c.get("id") if c else None, "name": c.get("name") if c else None,
              "role": c.get("role") if c else None, "sim": bool(c.get("sim")) if c else False,
              "x": c.get("x") if c else None, "y": c.get("y") if c else None,
              "lat": c.get("lat") if c else None, "lon": c.get("lon") if c else None, "acked": False, **extra}
        self.events.append(ev)
        self.events = self.events[-500:]
        try:
            os.makedirs(self.dir, exist_ok=True)
            with open(self._path("events.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps(ev, ensure_ascii=False) + "\n")
        except Exception:
            pass
        log.info(f"[{self.meta['name']}] {text}")
        await self.to_managers({"type": "event", "event": ev})
        if severity == "critical":
            _webhook(self, ev)
            _push(self, ev)
        return ev

    def save_push(self):
        with self.push_lock:
            self._write_json("push.json", self.push_subs)


class Store:
    def __init__(self):
        self.projects = {}
        for pid in sorted(os.listdir(ROOT)):
            try:
                with open(os.path.join(ROOT, pid, "project.json"), encoding="utf-8") as f:
                    meta = json.load(f)
                self.projects[meta["id"]] = Project(meta)
            except Exception:
                continue

    def get(self, pid) -> Project:
        p = self.projects.get(pid)
        if not p:
            raise HTTPException(status_code=404, detail="프로젝트를 찾을 수 없습니다.")
        return p

    def by_code(self, code):
        code = (code or "").strip().upper()
        return next((p for p in self.projects.values() if p.meta["join_code"] == code), None)

    def create(self, name, lat, lon):
        pid = secrets.token_hex(4)
        key = secrets.token_urlsafe(18)
        code = _code()
        while self.by_code(code):
            code = _code()
        meta = {"id": pid, "name": name, "origin": {"lat": lat, "lon": lon}, "created_at": time.time(),
                "join_code": code, "manager_key_sha256": _hash(key)}
        p = Project(meta)
        p.save_meta()
        self.projects[pid] = p
        return p, key


store = Store()


def _webhook(project, ev):
    url = os.environ.get("SOCMAP_WEBHOOK_URL")
    if not url:
        return
    text = f"[SOC-MAP · {project.meta['name']}] {ev['text']}"
    if ev.get("lat") is not None:
        text += f" (https://maps.google.com/?q={ev['lat']:.6f},{ev['lon']:.6f})"
    body = json.dumps({"text": text, "content": text, "event": ev}, ensure_ascii=False).encode("utf-8")

    def send():
        try:
            req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
            urllib.request.urlopen(req, timeout=5).close()
        except Exception as e:
            log.warning(f"웹훅 전송 실패: {e}")
    threading.Thread(target=send, daemon=True).start()


def _flat_contour(c):
    pts = []
    for pt in c or []:
        q = pt[0] if pt and isinstance(pt[0], (list, tuple)) else pt
        try:
            pts.append((float(q[0]), float(q[1])))
        except (TypeError, ValueError, IndexError):
            pass
    return pts


def _point_in_poly(x, y, poly):
    inside = False
    j = len(poly) - 1
    for i in range(len(poly)):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            inside = not inside
        j = i
    return inside


def _dist_to_poly(x, y, poly):
    best, bq = float("inf"), poly[0]
    for i in range(len(poly)):
        (ax, ay), (bx, by) = poly[i], poly[(i + 1) % len(poly)]
        dx, dy = bx - ax, by - ay
        t = 0.0 if dx == dy == 0 else max(0.0, min(1.0, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy)))
        qx, qy = ax + dx * t, ay + dy * t
        d = math.hypot(x - qx, y - qy)
        if d < best:
            best, bq = d, (qx, qy)
    return best, bq


def _compass(dx, dy):
    """현장 좌표 벡터(x = 동, y = 남) → 8방위"""
    brg = (math.degrees(math.atan2(dx, -dy)) + 360) % 360
    return ["북", "북동", "동", "남동", "남", "남서", "서", "북서"][round(brg / 45) % 8]


def _push(project, ev, only=None):
    """긴급 이벤트를 관리감독자 휴대폰에 Web Push 로 보낸다 (스레드). 사라진 구독(404·410)은 지운다"""
    subs = [s for s in project.push_subs if only is None or s["endpoint"] == only]
    if not subs:
        return
    sos = ev.get("kind") == "sos"
    data = {"title": f"🆘 긴급 호출 — {ev.get('name')}" if sos else f"SOC-MAP · {project.meta['name']}",
            "body": f"📍 {ev.get('location')}" + (f" (±{round(ev['acc'])} m)" if (ev.get("acc") or 0) >= 1 else "") if sos and ev.get("location") else ev["text"],
            "tag": ev.get("id"), "kind": ev.get("kind"), "severity": ev.get("severity"),
            "url": f"/supervisor#ev={ev.get('id')}", "ts": ev.get("ts")}

    def run():
        gone = []
        for s in subs:
            try:
                code = webpush.send(s, data)
                if code in (404, 410):
                    gone.append(s["endpoint"])
                elif code >= 400:
                    log.warning(f"푸시 전송 실패 {code}: {s.get('label') or s['endpoint'][:40]}")
            except Exception as e:
                log.warning(f"푸시 전송 오류: {e}")
        if gone:
            with project.push_lock:
                project.push_subs = [s for s in project.push_subs if s["endpoint"] not in gone]
            project.save_push()
            log.info(f"만료된 푸시 구독 {len(gone)}개 삭제")
    threading.Thread(target=run, daemon=True).start()


