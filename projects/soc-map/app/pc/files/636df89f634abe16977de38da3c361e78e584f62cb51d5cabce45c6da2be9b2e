def _fix(body):
    lat, lon, acc = body.get("lat"), body.get("lon"), body.get("acc")
    if not valid_latlon(lat, lon):
        raise HTTPException(status_code=400, detail="위치(위도·경도)가 올바르지 않습니다.")
    acc = float(acc) if isinstance(acc, (int, float)) and acc >= 0 else None
    return float(lat), float(lon), acc


def _join_radius(acc):
    return GPS_JOIN_M + min(acc or 0.0, GPS_ACC_CAP)


@router.post("/api/nearby")
async def nearby(request: Request):
    """휴대폰 위치로 주변 현장 찾기 — 참여 코드는 돌려주지 않는다"""
    lat, lon, acc = _fix(await request.json())
    found = []
    for p in store.projects.values():
        if not p.gps_join:
            continue
        d = p.site_distance(lat, lon)
        if d <= NEARBY_M:
            pub = p.public()
            found.append({"id": p.id, "name": pub["name"], "online": pub["online"], "distance_m": round(d),
                          "can_join": acc is not None and acc <= GPS_MAX_ACC and d <= _join_radius(acc)})
    found.sort(key=lambda f: f["distance_m"])
    return {"projects": found[:10], "join_radius_m": round(_join_radius(acc)), "acc": acc}


@router.post("/api/gps_join")
async def gps_join(request: Request):
    """현장 근처에서 보고한 위치를 확인하고 참여 코드를 발급(합류 이후 흐름은 코드 합류와 같다)"""
    body = await request.json()
    p = store.get(str(body.get("pid") or ""))
    lat, lon, acc = _fix(body)
    if not p.gps_join:
        raise HTTPException(status_code=403, detail="이 현장은 GPS 합류가 꺼져 있습니다. 관리자에게 받은 참여 코드를 입력하세요.")
    if acc is None or acc > GPS_MAX_ACC:
        raise HTTPException(status_code=400, detail=f"위치 정확도가 낮습니다(±{round(acc) if acc is not None else '?'} m). "
                            "하늘이 보이는 곳에서 다시 시도하거나 참여 코드를 입력하세요.")
    d = p.site_distance(lat, lon)
    if d > _join_radius(acc):
        raise HTTPException(status_code=403, detail=f"현장에서 {round(d)} m 떨어져 있습니다. 현장 안에서 다시 시도하세요.")
    await p.event("gps_join", None, f"📍 GPS 위치로 현장 인식 — 합류 요청 (현장까지 {round(d)} m, 오차 ±{round(acc)} m)")
    return {**p.public(), "code": p.meta["join_code"], "distance_m": round(d)}


