def _seg_dist(px, py, ax, ay, bx, by):
    dx, dy = bx - ax, by - ay
    L = dx * dx + dy * dy
    t = 0.0 if L == 0 else max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / L))
    return math.hypot(px - ax - t * dx, py - ay - t * dy)


def polygon_distance(x, y, poly):
    """평탄 다각형 [x0,y0,…] 까지 거리(m), 안이면 0"""
    n = len(poly) // 2
    inside, d = False, float("inf")
    for i in range(n):
        j = (i - 1) % n
        xi, yi, xj, yj = poly[2 * i], poly[2 * i + 1], poly[2 * j], poly[2 * j + 1]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            inside = not inside
        d = min(d, _seg_dist(x, y, xj, yj, xi, yi))
    return 0.0 if inside else d


def site_inside(site, x, y, margin=SITE_MARGIN_M):
    """현장 안인가: 경계(siteBoundary)가 있으면 경계 + margin, 없으면 배치 범위 사각형 + margin, 둘 다 없으면 안"""
    b = ((site or {}).get("doc") or {}).get("siteBoundary")
    if isinstance(b, list) and len(b) >= 6:
        return polygon_distance(x, y, b) <= margin
    ext = (site or {}).get("extent")
    if ext:
        return ext["minX"] - margin <= x <= ext["maxX"] + margin and ext["minY"] - margin <= y <= ext["maxY"] + margin
    return True


