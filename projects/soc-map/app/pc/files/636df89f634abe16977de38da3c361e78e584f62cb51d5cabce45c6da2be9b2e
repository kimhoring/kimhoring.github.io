async def _refuse(ws: WebSocket, code: int):
    """v14.12 받은 뒤에 닫아야 앱이 이유(4403 키·코드 틀림, 4409 시연 모드 불허)를 받는다.
    받기 전에 닫으면 브라우저에는 HTTP 403 → 닫힘 코드 1006 만 보여서 「참여 코드가 바뀌었습니다」 같은 안내가 뜨지 않았다"""
    await ws.accept()
    await ws.close(code=code)


@router.websocket("/ws/p/{pid}/manager")
async def ws_manager(ws: WebSocket, pid: str, key: Optional[str] = None):
    p = store.projects.get(pid)
    if not p or not p.check_manager(key):
        await _refuse(ws, 4403)
        return
    await ws.accept()
    p.managers.add(ws)
    await ws.send_json({"type": "snapshot", "clients": list(p.clients.values()), "events": p.events[-80:], "survey": p.survey,
                        "places": p.places, "policy": p.policy, "site_version": (p.site or {}).get("version", 0),
                        "weather": getattr(p, "weather", None),
                        "evac": p.evac.public(p.clients) if p.evac else None, "corr": p.corr.public()})
    try:
        while True:
            msg = await ws.receive_json()
            t = msg.get("type")
            if t == "message":
                text = str(msg.get("text", ""))[:200]
                payload = {"type": "message", "text": text, "level": msg.get("level", "info"), "ts": time.time()}
                if msg.get("to") == "all":
                    await p.to_clients(payload)
                    await p.event("broadcast", None, f"📢 전체 전송: {text}")
                    if payload["level"] == "evacuate" and not (p.evac and not p.evac.ended):
                        await _evac_start(p, text)
                else:
                    c = p.clients.get(msg.get("to"))
                    ok = await p.to_client(msg.get("to"), payload)
                    if c:
                        await p.event("message", c, f"💬 {c['name']}에게 전송{'' if ok else ' 실패(연결 끊김)'}: {text}")
            elif t == "ack":
                for ev in p.events:
                    if ev["id"] == msg.get("event_id"):
                        if ev.get("kind") == "sos" and not ev.get("acked") and ev.get("client_id"):
                            await p.to_client(ev["client_id"], {"type": "sos_ack", "event_id": ev["id"], "ts": time.time()})
                        if not ev.get("acked"):
                            report.append_jsonl(p._path("acks.jsonl"), {"event_id": ev["id"], "ts": time.time()})
                        ev["acked"] = True
                await p.to_managers({"type": "ack", "event_id": msg.get("event_id")})
            elif t == "evac_end":
                await _evac_end(p)
            elif t == "evac_safe" and msg.get("id"):      # 관리자가 직접 확인 (무전·대면)
                c2 = p.clients.get(msg["id"])
                who = p.evac.arrive(msg["id"], "manager") if p.evac else None
                if who and c2:
                    await _evac_arrived(p, c2, who)
            elif t == "ref_fix":                            # 기준점에 둔 휴대폰의 GPS
                await _ref_fix(p, msg)
            elif t == "remove":
                p.clients.pop(msg.get("id"), None)
                p.peers_dirty = True
                await p.to_managers({"type": "left", "id": msg.get("id")})
    except (WebSocketDisconnect, RuntimeError):
        pass
    finally:
        p.managers.discard(ws)


@router.websocket("/ws/p/{pid}/client")
async def ws_client(ws: WebSocket, pid: str, code: Optional[str] = None, key: Optional[str] = None,
                    id: Optional[str] = None, name: Optional[str] = None, role: str = "worker",
                    equipment: Optional[str] = None, sim: int = 0):
    p = store.projects.get(pid)
    if not p or not (p.check_code(code) or p.check_manager(key)):
        await _refuse(ws, 4403)
        return
    if sim and not p.policy["allow_sim"] and not p.check_manager(key):
        await _refuse(ws, 4409)   # 관리감독자가 시연 모드를 허용하지 않음 (가상 인원은 관리자 키로 접속하므로 예외)
        return
    await ws.accept()
    cid = re.sub(r"[^A-Za-z0-9_-]", "", id or "")[:40] or secrets.token_hex(5)
    role = role if role in ROLES else "worker"
    name = _clean_name(name, "작업자" if role == "worker" else "운전원")

    old = p.client_ws.get(cid)
    p.client_ws[cid] = ws
    if old is not None and old is not ws:
        try:
            await old.close()
        except Exception:
            pass
    c = p.clients.get(cid) or {"id": cid, "level": "safe", "risk": 0}
    was_offline = c.get("online") is False
    c.update({"name": name, "role": role, "equipment": equipment if role == "operator" else None,
              "online": True, "sim": bool(sim), "last_seen": time.time()})
    c.pop("_stale", None)
    c.pop("_left", None)
    p.clients[cid] = c
    p.peers_dirty = True
    await ws.send_json({"type": "hello", "id": cid, "site_version": (p.site or {}).get("version", 0),
                        "peers": p.peers(), "policy": p.policy, "places": p.places, "corr": p.corr.public(),
                        "evac": {"active": True, "state": p.evac.people.get(cid, {}).get("state")} if p.evac and not p.evac.ended else None})
    if p.evac and not p.evac.ended and p.evac.add(c):   # 대피 중에 들어온 사람도 명단에
        await _evac_push(p)
    await p.to_managers({"type": "client", "client": c})
    p.attend(c, "in")
    if was_offline:
        await p.event("online", c, f"🔌 {name} 연결 복구")
    elif role == "operator":
        await p.event("operator", c, f"🚜 {name} 장비 운전원 합류 ({p.equipment_label(equipment)})")
    if role == "operator" and equipment:
        dup = [o for o in p.clients.values() if o is not c and o.get("online") and o.get("role") == "operator" and o.get("equipment") == equipment]
        if dup:
            await p.event("duplicate", c, f"⚠️ {p.equipment_label(equipment)}에 운전원 {len(dup) + 1}명이 동시에 연결됨 "
                          f"({', '.join(o['name'] for o in dup)}, {name}) — 장비 위치가 섞일 수 있습니다", "warning")

    try:
        while True:
            msg = await ws.receive_json()
            t = msg.get("type")
            c["last_seen"] = time.time()
            if c.get("_stale"):   # 신호 끊김 뒤 같은 연결로 보고가 다시 옴 → 연결 복구 (전에는 다시 접속할 때까지 「끊김」으로 남았음)
                c.pop("_stale", None)
                c["online"] = True
                p.peers_dirty = True
                await p.to_managers({"type": "client", "client": c})
                await p.event("online", c, f"🔌 {c['name']} 연결 복구")
            p.attend(c, "in")   # 나감 뒤 다시 보고가 오면 들어옴 — 평소에는 아무것도 안 씀
            if t == "pos":
                prev = c.get("level", "safe")
                p.locate(c, msg)
                if c.get("inside_site") is False:
                    # 2026-11-24 현장 밖: 위치·위험도·작업 상태를 공유·기록하지 않는다 (마지막 위치는 긴급 호출 때만)
                    p.outside_pos[cid] = {k: c.get(k) for k in ("x", "y", "lat", "lon", "sigma", "acc")} | {"ts": time.time()}
                    was_in = c.get("x_shared", True)
                    for k in ("x", "y", "lat", "lon", "risk", "nearest_m", "source", "intrusions", "op_state", "vx", "vy", "speed", "heading", "floor"):
                        c.pop(k, None)
                    c["level"], c["x_shared"], c["_conflicts"] = "safe", False, []
                    if was_in:
                        p.peers_dirty = True
                        await p.to_managers({"type": "client", "client": c})
                    if p.evac and not p.evac.ended:
                        who = p.evac.arrive(cid, "outside")   # 현장을 벗어남 = 대피함
                        if who:
                            await _evac_arrived(p, c, who)
                    continue
                c["x_shared"] = True
                p.outside_pos.pop(cid, None)
                p.trace(c, msg)
                for k in ("acc", "sigma", "heading", "speed", "risk", "level", "nearest_m", "source", "battery", "intrusions"):
                    if k in msg:
                        c[k] = msg[k]
                if c.get("level") not in LEVEL_RANK:
                    c["level"] = "safe"
                await _report_extras(p, c, fieldops.clean_report(msg))
                p.peers_dirty = True
                await p.to_managers({"type": "client", "client": c})
                await _level_events(p, c, prev)
                if p.evac and not p.evac.ended:
                    who = p.evac.check_position(c, p.places)
                    if who:
                        await _evac_arrived(p, c, who)
            elif t == "sos":
                out = p.outside_pos.get(cid) if c.get("x") is None else None
                if out and out.get("x") is not None:   # 현장 밖에서 호출 — 마지막 위치를 이때만 알림
                    age = time.time() - out["ts"]
                    acc = out.get("sigma") or out.get("acc")
                    where = f"현장 밖 (현장에서 약 {round(p.site_distance(out['lat'], out['lon']))} m · {out['lat']:.5f}, {out['lon']:.5f})"
                    text = f"🆘 {c['name']} {'쓰러짐 감지 · 응답 없음' if msg.get('reason') == 'fall' else '긴급 호출'} — {where}"
                elif c.get("x") is not None:
                    age = time.time() - c.get("pos_ts", time.time())
                    where = p.describe_location(c["x"], c["y"])
                    acc = c.get("sigma") or c.get("acc")
                    stale = f" · 마지막 위치 {round(age)}초 전" if age > 15 else ""
                    what = "쓰러짐 감지 · 응답 없음" if msg.get("reason") == "fall" else "긴급 호출"
                    text = f"🆘 {c['name']} {what} — {where}{f' (±{round(acc)} m)' if acc and acc >= 1 else ''}{stale}"
                else:
                    where, acc, age = None, None, None
                    text = f"🆘 {c['name']} 긴급 호출 — 위치 정보 없음 (GPS 수신 전)"
                ev = await p.event("sos", c, text, "critical", location=where, acc=acc, fix_age=round(age) if age is not None else None)
                await ws.send_json({"type": "sos_sent", "event_id": ev["id"], "location": where, "acc": acc})
            elif t == "ack_message":
                await p.event("ack_message", c, f"✔️ {c['name']} 메시지 확인")
            elif t == "evac_safe":   # 대피 중 「안전한 곳에 도착」(대피 장소가 아닌 곳으로 피한 경우)
                who = p.evac.arrive(cid, "self") if p.evac else None
                if who:
                    await _evac_arrived(p, c, who)
            elif t == "leave":   # 「현장 나가기」 — 스스로 나간 것이므로 신호 끊김 경보를 내지 않는다
                c["_left"] = True
                p.attend(c, "out")
                await p.event("leave", c, f"🚪 {c['name']} 현장 나가기")
    except (WebSocketDisconnect, RuntimeError):
        pass
    finally:
        if p.client_ws.get(cid) is ws:
            p.client_ws.pop(cid, None)
            c["online"] = False
            p.attend(c, "out")
            p.peers_dirty = True
            if p.clients.get(cid) is c:   # 관리자가 이미 목록에서 지운 참여자는 다시 알리지 않음
                await p.to_managers({"type": "client", "client": c})


async def _report_extras(p, c, ext):
    """2026-11-22 위치 보고의 새 값: 속도 · 장비 작업 상태(바뀌면 기록) · 층 · 장비 간섭(새로 생기면 기록)
    2026-11-25 운전원: 장비에 타 있으면(도보 아님) 장비 자세 = 휴대폰 위치, 도보면 마지막 자세 그대로(장비는 그 자리에 정지).
    작업 중 작업 위치(work_at) — 운전원이 배치와 다른 곳을 작업 구역으로 정했을 때만 옴"""
    conflicts = ext.pop("conflicts", None)
    work_at = ext.pop("work_at", None)
    old_state = c.get("op_state")
    c.update(ext)
    if c.get("role") == "operator":
        if c.get("op_state") != "walk" and c.get("x") is not None:
            c["eq_x"], c["eq_y"], c["eq_heading"] = c["x"], c["y"], c.get("heading")
        old_work = (c.get("work_x"), c.get("work_y"))
        if work_at and c.get("op_state") == "work":
            wx, wy = p.frame.to_local(*work_at)
            c["work_x"], c["work_y"] = round(wx, 2), round(wy, 2)
        else:
            c.pop("work_x", None), c.pop("work_y", None)
        if c.get("work_x") is not None and old_work[0] is None:
            await p.event("work_zone", c, f"🚧 {p.equipment_label(c.get('equipment'))} 작업 구역을 운전원이 지금 위치로 정함 ({c['name']}) — "
                          f"{p.describe_location(c['work_x'], c['work_y'])}", "warning")
    if c.get("role") == "operator" and ext.get("op_state") and old_state and ext["op_state"] != old_state:
        await p.event("op_state", c, f"🚜 {p.equipment_label(c.get('equipment'))} {fieldops.OP_STATES[old_state]} → "
                      f"{fieldops.OP_STATES[ext['op_state']]} ({c['name']})", op_state=ext["op_state"])
    if conflicts is not None:
        prev = set(c.get("_conflicts") or [])
        for text in conflicts:
            if text not in prev:
                await p.event("conflict", c, f"⚠️ 장비 간섭: {text}", "warning")
        c["_conflicts"] = conflicts


async def _evac_push(p):
    await p.to_managers({"type": "evac", "evac": p.evac.public(p.clients) if p.evac else None})


async def _evac_start(p, text):
    p.evac = fieldops.Evac([c for c in p.clients.values() if c.get("online")], text)
    n = len(p.evac.people)
    await p.event("evac_start", None, f"🚨 대피 시작 — 대상 {n}명 (대피 장소 도착 또는 본인 확인으로 점호)", "warning")
    await _evac_push(p)


async def _evac_arrived(p, c, who):
    how = {"place": f"{who['place']} 도착", "self": "안전한 곳 도착 (본인 확인)", "manager": "관리자 확인", "outside": "현장 밖으로 나감"}.get(who["how"], "도착")
    await p.event("evac_arrived", c, f"✅ {who['name']} 대피 — {how}")
    await p.to_client(c["id"], {"type": "evac_status", "state": "arrived", "how": who["how"], "place": who.get("place")})
    await _evac_push(p)


async def _evac_end(p):
    if not p.evac or p.evac.ended:
        return
    p.evac.ended = time.time()
    k = p.evac.counts(p.clients)
    missing = [q["name"] for q in p.evac.people.values() if q["state"] != "arrived"]
    mins = round((p.evac.ended - p.evac.start) / 60, 1)
    text = f"🏁 대피 종료 ({mins}분) — 도착 {k['arrived']}/{k['total']}명" + (f", 확인 안 됨: {', '.join(missing)}" if missing else "")
    await p.event("evac_end", None, text, "warning" if missing else "info")
    await p.to_clients({"type": "evac_status", "state": "ended"})
    await _evac_push(p)


async def _ref_fix(p, msg):
    place = next((q for q in p.places if q.get("id") == msg.get("place") and q.get("kind") == "ref"), None)
    lat, lon = msg.get("lat"), msg.get("lon")
    if not place or not valid_latlon(lat, lon):
        return
    rx, ry = p.frame.to_local(float(lat), float(lon))
    if not p.corr.update(rx, ry, place["x"], place["y"], msg.get("acc"), place=place["id"], by=msg.get("by")):
        return
    now = time.time()
    pub = p.corr.public(now)
    if pub and now - p._corr_sent >= 2:          # 2초마다 휴대폰들에
        p._corr_sent = now
        await p.to_clients({"type": "corr", "corr": pub})
        await p.to_managers({"type": "corr", "corr": pub})


async def _level_events(p, c, prev):
    new = c["level"]
    name = c["name"]
    if c.get("role") == "operator":
        # 운전원: 작업 반경 안에 들어온 작업자 수 변화
        n_now = len(c.get("intrusions") or [])
        n_prev = c.get("_intrusions_prev", 0)
        if n_now > n_prev:
            names = ", ".join(p.clients[i]["name"] for i in (c.get("intrusions") or []) if i in p.clients)
            await p.event("intrusion", c, f"🚜 {name}({p.equipment_label(c.get('equipment'))}) 작업 반경 내 작업자 {n_now}명: {names}", "warning")
        c["_intrusions_prev"] = n_now
    if new == prev:
        return
    src = f" — {c.get('source')}" if c.get("source") else ""
    if new == "danger":
        await p.event("enter", c, f"🚨 {name} 위험 구역 진입{src}", "critical", risk=c.get("risk"), source=c.get("source"))
    elif new == "warning" and LEVEL_RANK[prev] < LEVEL_RANK["warning"]:
        dist = f" ({c.get('nearest_m')}m)" if c.get("nearest_m") is not None else ""
        await p.event("approach", c, f"⚠️ {name} 위험 구역 접근{dist}{src}", "warning", source=c.get("source"))
    elif prev == "danger":
        await p.event("exit", c, f"✅ {name} 위험 구역 이탈 (현재: {LEVEL_LABEL[new]})")


async def background():
    """1초마다 위치 목록 방송, 5초마다 신호 끊김 감시"""
    tick = 0
    while True:
        await asyncio.sleep(1)
        tick += 1
        now = time.time()
        for p in list(store.projects.values()):
            if p.peers_dirty and p.client_ws:
                p.peers_dirty = False
                await p.to_clients({"type": "peers", "peers": p.peers(), "ts": now})
            if tick % 300 == 0:   # 5분마다 접속 중인 사람 기록 → 서버가 갑자기 꺼져도 출입 시간이 5분 안으로 맞음
                for c in list(p.clients.values()):
                    p.attend(c, "seen")
            if tick % 5:
                continue
            for c in list(p.clients.values()):
                stale = now - c.get("last_seen", now) > OFFLINE_SEC and not c.get("_left")
                if stale and not c.get("_stale"):
                    c["_stale"] = True
                    c["online"] = False
                    p.peers_dirty = True
                    sev = "critical" if c.get("level") == "danger" else "warning"
                    p.attend(c, "out", ts=c.get("last_seen"))
                    await p.event("offline", c, f"📵 {c['name']} 신호 끊김 ({OFFLINE_SEC}초 이상 보고 없음)", sev)
                    await p.to_managers({"type": "client", "client": c})
                if c.get("sim") and not c.get("online") and now - c.get("last_seen", now) > 600:
                    p.clients.pop(c["id"], None)
                    await p.to_managers({"type": "left", "id": c["id"]})
