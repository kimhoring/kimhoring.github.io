def _place_pos(p, b):
    if valid_latlon(b.get("lat"), b.get("lon")):
        lat, lon = float(b["lat"]), float(b["lon"])
        x, y = p.frame.to_local(lat, lon)
    elif isinstance(b.get("x"), (int, float)) and isinstance(b.get("y"), (int, float)):
        x, y = float(b["x"]), float(b["y"])
        lat, lon = p.frame.to_latlon(x, y)
    else:
        raise HTTPException(status_code=400, detail="위치(위도·경도 또는 현장 좌표)가 필요합니다.")
    if math.hypot(x, y) > 5000:
        raise HTTPException(status_code=400, detail="현장에서 너무 먼 위치입니다.")
    return round(x, 2), round(y, 2), lat, lon


