def _apk_list():
    try:
        with open(os.path.join(DOWNLOAD_DIR, "apps.json"), encoding="utf-8") as f:
            apps = json.load(f).get("apps", [])
    except (OSError, ValueError):
        return []
    return [a for a in apps if os.path.isfile(os.path.join(DOWNLOAD_DIR, a.get("file", "")))]


