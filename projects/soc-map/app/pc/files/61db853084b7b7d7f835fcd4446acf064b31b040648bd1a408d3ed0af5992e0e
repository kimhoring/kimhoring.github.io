)


@app.middleware("http")
async def _fresh_app_code(request, call_next):
    """v14.14 휴대폰 앱 화면(/app/…)은 항상 노트북의 최신 코드 — 캐시 지시가 없으면 WebView 가 옛 JS 를 하루 넘게 쓸 수 있다.
    no-cache 는 저장은 하되 쓸 때마다 확인(ETag → 바뀐 게 없으면 304) 이라 가볍다"""
    resp = await call_next(request)
    if request.url.path.startswith(("/app/", "/download/shell/")) and "cache-control" not in resp.headers:
        resp.headers["Cache-Control"] = "no-cache"
    return resp


