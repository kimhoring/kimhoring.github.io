@app.api_route("/download/{fname}", methods=["GET", "HEAD"])
def download_apk(fname: str):
    app_info = next((a for a in _apk_list() if a["file"] == fname), None)
    if not app_info:
        raise HTTPException(status_code=404, detail="APK가 없습니다. 노트북에서 android/build_apk.py 로 먼저 빌드하세요.")
    return FileResponse(os.path.join(DOWNLOAD_DIR, fname), media_type="application/vnd.android.package-archive",
                        filename=fname, headers=NO_CACHE)


SHELL_DIR = os.path.join(DOWNLOAD_DIR, "shell")


@app.api_route("/download/shell/{fname}", methods=["GET", "HEAD"])
def shell_file(fname: str):
    """v14.14 안드로이드 앱 화면 패치(첫 화면 파일) — shell.json 에 적힌 파일만. 앱이 SHA-256 을 확인하고 바꿔 끼운다"""
    try:
        with open(os.path.join(SHELL_DIR, "shell.json"), encoding="utf-8") as f:
            allowed = set(json.load(f).get("files", {})) | {"shell.json"}
    except (OSError, ValueError):
        raise HTTPException(status_code=404, detail="화면 패치가 없습니다. android/build_apk.py --shell 로 만드세요.")
    if fname not in allowed or not os.path.isfile(os.path.join(SHELL_DIR, fname)):
        raise HTTPException(status_code=404)
    kind = {".json": "application/json", ".js": "text/javascript", ".html": "text/html"}.get(os.path.splitext(fname)[1], "application/octet-stream")
    return FileResponse(os.path.join(SHELL_DIR, fname), media_type=kind, headers=NO_CACHE)


