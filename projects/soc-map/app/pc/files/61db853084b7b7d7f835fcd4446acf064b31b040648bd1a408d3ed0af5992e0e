    parser.add_argument("--https-port", type=int, default=8443)
    parser.add_argument("--trace", action="store_true", help="경보 현장 시험용: 모든 위치 보고를 projects/{pid}/trace.jsonl 에 기록")
    parser.add_argument("--tunnel", action="store_true", help="cloudflared 빠른 터널로 정식 인증서 https 주소 생성 (앱 설치·푸시 알림용)")
    parser.add_argument("--public-url", default=None, help="QR 에 쓸 공개 https 주소 (직접 연 터널·도메인)")
