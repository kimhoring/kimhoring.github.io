class _ConsoleFormat(logging.Formatter):
    """콘솔: 「시:분:초  메시지」, 경고는 앞에 「주의:」"""
    def format(self, r):
        t = time.strftime("%H:%M:%S", time.localtime(r.created))
        return f"{t}  {'주의: ' if r.levelno >= logging.WARNING else ''}{r.getMessage()}"


def _setup_logging(quiet):
    """v14.12 콘솔은 짧게(quiet), 모든 기록은 logs/server.log 에 — 연동 문제를 나중에 확인할 수 있게"""
    # AI 라이브러리(ultralytics)가 불러올 때 출력을 UTF-8 로 바꾸므로, 한국어 윈도우 콘솔(cp949)도 UTF-8 로 맞춰야 한글이 안 깨진다
    if os.name == "nt":
        try:
            import ctypes
            ctypes.windll.kernel32.SetConsoleOutputCP(65001)
        except Exception:
            pass
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(encoding="utf-8", errors="replace")
    root = logging.getLogger()
    for h in list(root.handlers):
        root.removeHandler(h)
    con = logging.StreamHandler(sys.stdout)
    con.setFormatter(_ConsoleFormat() if quiet else logging.Formatter("[%(levelname)s] %(message)s"))
    root.addHandler(con)
    root.setLevel(logging.INFO)
    try:
        from logging.handlers import RotatingFileHandler
        os.makedirs(LOG_DIR, exist_ok=True)
        fh = RotatingFileHandler(os.path.join(LOG_DIR, "server.log"), maxBytes=1_000_000, backupCount=3, encoding="utf-8")
        fh.setFormatter(logging.Formatter("%(asctime)s [%(levelname)s] %(name)s: %(message)s"))
        root.addHandler(fh)
    except OSError:
        pass


@asynccontextmanager
async def lifespan(app):
    # 2026-11-24 가볍게: AI 건물 인식 모델(YOLO·ultralytics·torch)은 미리 올리지 않고 처음 쓸 때 불러온다
    #   (미리 올리면 메모리 +178 MB · 시작 +2.3 초인데, 도면 AI 인식을 할 때만 씀. 첫 인식만 2~3초 더 걸림)
    if not getattr(app.state, "model_tried", False):
        app.state.model_tried = True
        if not model_info()["model_exists"]:
            log.error("AI 건물 인식 모델 파일이 없습니다(지도·관제는 그대로 동작) — models/best.pt")
    # --https 모드에서는 서버 2개가 같은 앱을 쓰므로 감시 작업은 한 번만 시작
    task = None
    if not getattr(app.state, "watchdog_started", False):
        app.state.watchdog_started = True
        task = asyncio.create_task(projects.background())
        wx_task = asyncio.create_task(weather.background())   # 기상청 날씨 (키가 없으면 바로 끝남)
    yield
    if task:
        task.cancel()
        wx_task.cancel()


