def _read_upload(file: UploadFile):
    if file.content_type and not file.content_type.startswith("image/"):
        raise HTTPException(status_code=400, detail="이미지 파일만 업로드할 수 있습니다.")
    contents = file.file.read(MAX_UPLOAD_BYTES + 1)
    if len(contents) > MAX_UPLOAD_BYTES:
        raise HTTPException(status_code=413, detail="이미지가 너무 큽니다 (최대 25MB).")
    return contents


# 동기 함수로 선언하면 FastAPI 가 스레드풀에서 실행하므로 추론 중에도 /health 가 응답한다
@app.post("/api/detect_buildings")
def detect_buildings(
    file: UploadFile = File(...),
    imageType: str = Form("floorplan"),
    conf: float = Form(0.25),
    imgsz: int = Form(1024),
    tiling: str = Form("auto"),
    tta: bool = Form(False),
    enhance: bool = Form(False),
):
    if not 0.01 <= conf <= 0.95:
        raise HTTPException(status_code=400, detail="conf 는 0.01 ~ 0.95 사이여야 합니다.")
    if imgsz not in (640, 800, 1024, 1280, 1600):
        raise HTTPException(status_code=400, detail="imgsz 는 640/800/1024/1280/1600 중 하나여야 합니다.")
    if tiling not in ("auto", "on", "off"):
        raise HTTPException(status_code=400, detail="tiling 은 auto/on/off 중 하나여야 합니다.")
    contents = _read_upload(file)

    try:
        result = extract_buildings_yolo(contents, conf=conf, imgsz=imgsz, tiling=tiling, tta=tta, enhance=enhance)
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except FileNotFoundError as e:
        log.error(f"Model error: {e}")
        raise HTTPException(status_code=500, detail="서버에 YOLO 모델 파일(best.pt)이 없습니다.")
    except Exception as e:
        log.exception("Inference error")
        raise HTTPException(status_code=500, detail=f"추론 중 오류: {e}")

    result["imageType"] = imageType
    meta = result["meta"]
    log.info(f"{file.filename}: 건물 {len(result['contours'])}개 (원시 {meta['raw_detections']}, 타일 {meta['tiles']}, "
             f"imgsz {imgsz}, {result['inference_ms']} ms)")
    return result


