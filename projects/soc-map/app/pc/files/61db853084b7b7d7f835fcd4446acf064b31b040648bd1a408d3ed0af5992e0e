_NO_GZIP_EXT = (".apk", ".png", ".jpg", ".jpeg", ".webp", ".gif", ".pt", ".onnx", ".zip", ".pdf", ".ico")


class _TextGZip:
    def __init__(self, app):
        self.app, self.gz = app, GZipMiddleware(app, minimum_size=1024, compresslevel=6)

    async def __call__(self, scope, receive, send):
        if scope["type"] == "http":
            path = scope.get("path", "")
            if not path.lower().endswith(_NO_GZIP_EXT) and not path.startswith(("/cadastral/", "/worker.apk", "/supervisor.apk")):
                return await self.gz(scope, receive, send)
        return await self.app(scope, receive, send)


app.add_middleware(_TextGZip)
