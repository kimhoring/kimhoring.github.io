MAX_DXF_BYTES = 80 * 1024 * 1024


@app.post("/api/plan/dxf")
def plan_dxf(file: UploadFile = File(...), layers: str = Form("")):
    """v14.7 CAD 원본(DXF) 배치도 → 실제 단위(m) 건물 외곽선·선·동 이름·TM 여부 (dxf_import.py, ezdxf)"""
    data = file.file.read(MAX_DXF_BYTES + 1)
    if len(data) > MAX_DXF_BYTES:
        raise HTTPException(status_code=413, detail="DXF 파일이 너무 큽니다 (최대 80MB).")
    try:
        chosen = json.loads(layers) if layers else None
        assert chosen is None or (isinstance(chosen, list) and all(isinstance(s, str) for s in chosen))
    except Exception:
        raise HTTPException(status_code=400, detail="layers 는 레이어 이름 목록(JSON)이어야 합니다.")
    try:
        import dxf_import
        r = dxf_import.read_dxf(data, chosen)
    except ImportError:
        raise HTTPException(status_code=503, detail="서버에 ezdxf·shapely 가 없습니다 (pip install -r requirements.txt).")
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        log.exception("DXF error")
        raise HTTPException(status_code=500, detail=f"DXF 처리 중 오류: {e}")
    log.info(f"DXF {file.filename}: 건물 {len(r['buildings'])}동, 단위 {r['units']}, 레이어 {r['chosen_layers']}, TM {bool(r['tm'])}")
    return r


@app.post("/api/segment_building")
def segment_building(
    file: UploadFile = File(None),
    image_id: str = Form(""),
    point: str = Form(""),
    box: str = Form(""),
    source: str = Form(""),
):
    """v14.7 클릭(점) 또는 사각형으로 건물 외곽선 한 개 따기 — MobileSAM (sam_inference.py)
    도면은 처음 한 번만 올리고(file) 이후에는 돌려받은 image_id 만 보낸다. 서버에 없으면 404 → 다시 올림."""
    if file is not None and file.filename:
        try:
            image_id = sam_inference.put_image(_read_upload(file))
        except ValueError as e:
            raise HTTPException(status_code=400, detail=str(e))
    try:
        pt = json.loads(point) if point else None
        bx = json.loads(box) if box else None
        assert (pt is None) != (bx is None)
        assert pt is None or (len(pt) == 2 and all(isinstance(v, (int, float)) for v in pt))
        assert bx is None or (len(bx) == 4 and all(isinstance(v, (int, float)) for v in bx))
    except Exception:
        raise HTTPException(status_code=400, detail="point [x, y] 또는 box [x1, y1, x2, y2] 중 하나를 보내세요 (도면 px).")
    try:
        r = sam_inference.segment(image_id, point=pt, box=bx, aerial=source == "satellite")   # 2026-11-22 위성: 조각 합치기 · 바닥 판정
    except KeyError:
        raise HTTPException(status_code=404, detail="image_not_cached")
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except FileNotFoundError as e:
        raise HTTPException(status_code=503, detail=str(e))
    except Exception as e:
        log.exception("SAM error")
        raise HTTPException(status_code=500, detail=f"외곽선 따기 중 오류: {e}")
    log.info(f"외곽선 따기 {'위성 ' if source == 'satellite' else ''}{'점' if pt else '사각형'}: "
             f"{'성공' if r.get('polygon') else '바닥 같음' if r.get('ground') else '실패'} ({r['ms']} ms)")
    return r


@app.post("/api/geom/union")
def geom_union(body: dict):
    """2026-11-22 겹치는 외곽선(현장 m)을 한 건물로 합치기 — AI 건물 따기로 지붕을 조각조각 땄을 때 (polyops.py)"""
    polys = body.get("polys") if isinstance(body, dict) else None
    if not isinstance(polys, list) or not 2 <= len(polys) <= 20 or any(
            not isinstance(p, list) or not 6 <= len(p) <= 20000 or not all(isinstance(v, (int, float)) for v in p) for p in polys):
        raise HTTPException(status_code=400, detail="polys: 외곽선 2~20개, 각 [x0, y0, x1, y1, …] (m)")
    close = body.get("close", 0.3)
    if not isinstance(close, (int, float)) or not 0.05 <= close <= 1.0:
        raise HTTPException(status_code=400, detail="close: 0.05 ~ 1.0 m")
    try:
        return polyops.union(polys, close=float(close))
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))


def _open_manager_window(url):
    """노트북에서 관리자 화면을 앱 창(주소창·탭 없는 창, 최대화)으로 연다. Chrome → Edge → 기본 브라우저 순"""
    import subprocess
    import webbrowser
    env = os.environ.get
    cands = [
        os.path.join(env("ProgramFiles", ""), "Google", "Chrome", "Application", "chrome.exe"),
        os.path.join(env("ProgramFiles(x86)", ""), "Google", "Chrome", "Application", "chrome.exe"),
        os.path.join(env("LOCALAPPDATA", ""), "Google", "Chrome", "Application", "chrome.exe"),
        os.path.join(env("ProgramFiles(x86)", ""), "Microsoft", "Edge", "Application", "msedge.exe"),
        os.path.join(env("ProgramFiles", ""), "Microsoft", "Edge", "Application", "msedge.exe"),
    ]
    for exe in cands:
        if os.path.isfile(exe):
            subprocess.Popen([exe, f"--app={url}", "--start-maximized"])
            return os.path.basename(exe)
    webbrowser.open(url)
    return "기본 브라우저"


async def _serve(args):
    """HTTP 서버, 그리고 --https 이면 같은 앱(같은 메모리 상태)을 HTTPS 로도 동시에 띄운다"""
    # quiet: uvicorn 의 영어 시작 문구·요청마다 찍히는 줄을 콘솔에서 뺀다 (log_config=None → 우리 로그 설정을 그대로 씀)
    ulog = dict(log_level="warning" if args.quiet else "info", access_log=not args.quiet, log_config=None)
    configs = [uvicorn.Config(app, host=args.host, port=args.port, **ulog)]
    app.state.http_port = args.port
    if args.https:
        import certs
        cert, key = certs.ensure_self_signed()
        configs.append(uvicorn.Config(app, host=args.host, port=args.https_port, ssl_certfile=cert, ssl_keyfile=key, **ulog))
        app.state.https_port = args.https_port
    shown = projects.lan_addresses() if args.host == "0.0.0.0" else [args.host]
    if not args.quiet:
        for ip in shown:
            base = f"{'https' if args.https else 'http'}://{ip}:{args.https_port if args.https else args.port}"
            log.info(f"관리자 지도   : http://{ip}:{args.port}/map")
            log.info(f"근로자 앱     : {base}/worker")
            log.info(f"관리감독자 앱 : {base}/supervisor")
    app.state.public_url = args.public_url.rstrip("/") if args.public_url else None
    ready = _Ready(args, shown)
    if args.tunnel:
        import atexit
        import tunnel

        def on_url(url):
            # v14.12 주소가 나와도 바로 알리지 않는다: 실제로 응답할 때까지 확인한 뒤 QR·안내판에 쓴다
            app.state.public_url, app.state.tunnel_ready, app.state.directory = url, False, None
            log.info(f"인터넷 주소를 여는 중: {url}")

            def work():
                ok = directory.wait_reachable(url)
                if app.state.public_url != url:   # 그 사이 터널이 다시 열려 주소가 바뀜
                    return
                app.state.tunnel_ready = ok
                if ok:
                    log.info("인터넷 주소 연결 확인 — 휴대폰이 어디서나 접속할 수 있습니다")
                else:
                    log.warning("인터넷 주소가 2분 안에 응답하지 않습니다. 노트북 인터넷 연결을 확인하세요(같은 와이파이 연결은 됩니다).")
                ready.update(tunnel="ready" if ok else "failed")

                def board_done(st):
                    app.state.directory = st
                    ready.update(board=st, url=url)
                directory.publish_async(url, board_done)   # 휴대폰이 새 주소를 찾아오게
            threading.Thread(target=work, daemon=True).start()

        def on_down():
            app.state.public_url, app.state.tunnel_ready = None, False   # 관리자 QR 은 잠시 와이파이 주소로

        t = tunnel.start(args.port, on_url, on_down)
        if t:
            atexit.register(t.stop)
        else:
            ready.update(tunnel="none", board="none")
    servers = [uvicorn.Server(c) for c in configs]

    async def when_started():
        for _ in range(600):   # 최대 60초 (AI 모델 로드 포함)
            if all(s.started for s in servers):
                break
            await asyncio.sleep(0.1)
        if args.open:
            url = f"http://localhost:{args.port}/map"
            how = _open_manager_window(url)
            log.info(f"관리자 화면을 열었습니다 ({how})")
        ready.update(servers=True)

    asyncio.get_running_loop().create_task(when_started())
    await asyncio.gather(*(s.serve() for s in servers))


class _Ready:
    """v14.12 서버 · 인터넷 주소 · 안내판이 모두 준비되면 「준비 완료」를 한 번 크게 알린다. 그 뒤 주소가 바뀌면 한 줄로"""

    def __init__(self, args, shown):
        self.args, self.shown, self.lock = args, shown, threading.Lock()
        self.servers, self.tunnel, self.board, self.url, self.done = False, None, None, None, False
        if not args.tunnel:
            self.tunnel = self.board = "none"

    def update(self, **kw):
        with self.lock:
            for k, v in kw.items():
                setattr(self, k, v)
            if not (self.servers and self.tunnel is not None and self.board is not None):
                return
            first, self.done = not self.done, True
        if first:
            self._banner()
        elif "board" in kw and self.board == "ok":
            log.info("인터넷 주소가 바뀌었습니다 → 휴대폰 앱이 새 주소로 저절로 다시 연결됩니다")

    def _banner(self):
        a = self.args
        if self.tunnel == "ready" and self.board == "ok":
            phone = "앱에서 참여 코드만 넣으면 됩니다 (노트북을 다시 켜도 자동으로 다시 연결)"
        elif self.tunnel == "ready" and self.board == "failed":
            phone = "관리자 화면의 [현장 합류] QR 로 연결하세요 (자동 연결 안 됨: gh auth status 확인)"
        elif self.tunnel == "ready":
            phone = "관리자 화면의 [현장 합류] QR 로 연결하세요"
        else:
            phone = "같은 와이파이의 휴대폰만 연결됩니다 (관리자 화면의 [현장 합류] QR)"
        lines = ["", "=" * 60, "  [준비 완료] SOC-MAP" + ("  (경보 시험 기록 모드)" if a.trace else ""),
                 f"  관리자 화면 : {'이 노트북에 열었습니다' if a.open else f'http://localhost:{a.port}/map'}",
                 f"  휴대폰      : {phone}"]
        if self.tunnel == "ready" and self.url:
            lines.append(f"  인터넷 주소 : {self.url}")
        lines += ["  이 창을 닫으면 서버가 꺼집니다.", "=" * 60, ""]
        print("\n".join(lines), flush=True)
        log.debug("준비 완료 안내를 띄웠습니다")


