// ═══════════════════════════════════════════════
//  안전 경로 (대피 장소 · 목적지 · 이름 붙은 건물)
// ═══════════════════════════════════════════════

function namedBuildings() {
  const bd = (A.site && A.site.doc && A.site.doc.buildingData) || {};
  return A.contourPolys.map((p, i) => ({ p, i, name: (bd[i] || {}).name }))
    .filter(b => b.name && b.p.length >= 6)
    .map(b => { const c = polygonCentroid(b.p); return { id: null, kind: 'building', name: b.name, x: c.x, y: c.y }; });
}

function openDest() {
  if (A.picking) { A.picking = false; setChip(); return; }
  const here = A.est, dist = (o) => (here ? Math.hypot(o.x - here.x, o.y - here.y) : null);
  const opts = [...A.places, ...namedBuildings()];
  const rank = { assembly: 0, dest: 1, building: 2 };
  opts.sort((a, b) => rank[a.kind] - rank[b.kind] || (dist(a) ?? 0) - (dist(b) ?? 0));
  const kindLabel = { assembly: '대피 장소', dest: '목적지', building: '건물' };
  $('destList').innerHTML = opts.length ? opts.map((o, k) => `<button data-k="${k}">
      <span class="dest-ic">${o.kind === 'assembly' ? '🟢' : o.kind === 'building' ? '🏢' : '📍'}</span>
      <span class="dest-b"><b>${esc(o.name)}</b><small>${kindLabel[o.kind]}${dist(o) != null ? ` · 직선 ${fmtM(dist(o))}` : ''}</small></span></button>`).join('')
    : '<div class="empty">관리감독자가 등록한 대피 장소·목적지가 없습니다.<br>아래 「지도에서 직접 고르기」를 쓰세요.</div>';
  $('destList').onclick = (e) => { const b = e.target.closest('[data-k]'); if (!b) return; $('destSheet').hidden = true; setDest(opts[+b.dataset.k]); };
  openSheet('destSheet');
}
$('routeBtn').addEventListener('click', openDest);
$('destPickBtn').addEventListener('click', () => {
  $('destSheet').hidden = true; A.picking = true; setChip();
  if (map.mode === 'follow') map.setMode('fit');
  requestRender();
});

function setDest(d, evac = false) {
  A.dest = { id: d.id || null, name: d.name || '선택한 지점', kind: d.kind || 'point', x: d.x, y: d.y, evac };
  A.route = null; A.routeSig = ''; A.routeAt = 0; A.picking = false; setChip();
  if (A.est) computeRoute(); else renderRoute();
  requestRender();
}
function clearRoute(reason) {
  A.dest = null; A.route = null; A.picking = false;
  setChip(); renderRoute(); requestRender();
  if (reason) addAlert('info', '🧭', reason);
}

/** 장비 위치·방향 요약 — 바뀌면 경로를 다시 찾는다 (2 m · 약 10° 단위) */
const liveSig = () => (A.field ? A.field.equipments.map(eq => `${Math.round(eq.xc / 2)},${Math.round(eq.yc / 2)},${Math.round(eq.heading * 6)}${eq.isFullControl() ? 'F' : ''}`).join('|') : '');

/** 관리자 화면과 같은 planRoute — 근로자는 항상 안전 우선도 최대(가중치 1) */
function computeRoute() {
  if (!A.dest || !A.est || !A.field || !A.site) return;
  const doc = A.site.doc || {}, e = A.site.extent, s = A.est, d = A.dest, pad = 15;
  const minX = Math.min(e.minX, s.x - pad, d.x - pad), minY = Math.min(e.minY, s.y - pad, d.y - pad);
  const maxX = Math.max(e.maxX, s.x + pad, d.x + pad), maxY = Math.max(e.maxY, s.y + pad, d.y + pad);
  const r = planRoute({
    ext: { minX, minY, maxX, maxY, w: maxX - minX, h: maxY - minY },
    contours: doc.contours || [], walkable: doc.siteBoundary || doc.walkableAreaPolygon || [], fences: doc.fences || [],
    field: A.field, start: { x: s.x, y: s.y }, end: { x: d.x, y: d.y }, weight: 1,
  });
  A.routeAt = Date.now(); A.routeSig = liveSig();
  A.route = r ? { path: r.path, metrics: r.metrics } : { fail: true };
  renderRoute(); requestRender();
}

/** 경로 위 내 위치: 경로에서 벗어난 거리 · 남은 거리 */
function routeProgress() {
  const p = A.route && A.route.path;
  if (!p || p.length < 4 || !A.est) return null;
  const { x, y } = A.est;
  let best = Infinity, seg = 0, tt = 0;
  for (let i = 0; i + 3 < p.length; i += 2) {
    const ax = p[i], ay = p[i + 1], dx = p[i + 2] - ax, dy = p[i + 3] - ay, L2 = dx * dx + dy * dy;
    const t = L2 ? Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / L2)) : 0;
    const dd = Math.hypot(x - (ax + dx * t), y - (ay + dy * t));
    if (dd < best) { best = dd; seg = i; tt = t; }
  }
  let rem = Math.hypot(p[seg + 2] - p[seg], p[seg + 3] - p[seg + 1]) * (1 - tt);
  for (let i = seg + 2; i + 3 < p.length; i += 2) rem += Math.hypot(p[i + 2] - p[i], p[i + 3] - p[i + 1]);
  return { off: best, remaining: rem, seg, t: tt };
}
function remainingPath() {
  const p = A.route.path, q = routeProgress();
  if (!q) return p;
  const i = q.seg, ax = p[i], ay = p[i + 1], bx = p[i + 2], by = p[i + 3];
  return [A.est.x, A.est.y, ax + (bx - ax) * q.t, ay + (by - ay) * q.t, ...p.slice(i + 2)];
}

/** 1초마다: 도착 확인 · 경로 이탈이나 장비 이동 시 다시 찾기 */
function updateRoute() {
  if (!A.dest || !A.est) return;
  const toDest = Math.hypot(A.dest.x - A.est.x, A.dest.y - A.est.y);
  if (toDest <= Math.max(4, Math.min(10, A.est.sigma || 0))) {
    const n = A.dest.name;
    clearRoute(); addAlert('info', '🏁', `${n}에 도착했습니다.`); beep(1320, 0.15); vibrate([100, 60, 100]);
    return;
  }
  const q = routeProgress(), now = Date.now();
  const offRoute = q && q.off > 8 + Math.min(8, A.est.sigma || 0);
  const again = !A.route || A.route.fail ? now - A.routeAt > 5000 : offRoute || (A.routeSig !== liveSig() && now - A.routeAt > 3000);
  if (again) computeRoute(); else renderRoute(q);
}

function renderRoute(q) {
  const card = $('routeCard');
  $('routeBtn').hidden = !A.running || meDriving() || !!A.dest;
  if (!A.dest) { card.hidden = true; return; }
  q = q || routeProgress();
  const r = A.route, evac = A.dest.evac;
  let body;
  if (!A.est) body = '<small>내 위치를 확인하는 중…</small>';
  else if (!r) body = '<small>경로를 찾는 중…</small>';
  else if (r.fail) body = '<small class="warn">경로를 찾지 못했습니다. 울타리·건물로 막혀 있을 수 있습니다. 잠시 후 다시 찾습니다.</small>';
  else {
    const rem = q ? q.remaining : r.metrics.length, min = Math.max(1, Math.round(rem / WALK_MPS / 60)), g = riskGrade(r.metrics.maxRisk);
    body = `<div class="rc-main"><b>${fmtM(rem)}</b><span>약 ${min}분</span><span class="rc-risk" style="color:${g.color}">경로 최대 위험 ${Math.round(r.metrics.maxRisk)}</span></div>`
      + (A.assess && A.assess.level === 'danger' ? '<small class="warn">🚨 지금 위험 구역 안입니다 — 경로를 따라 즉시 벗어나세요.</small>'
        : r.metrics.maxRisk >= SAFETY.DANGER_R ? '<small class="warn">⚠️ 위험 구역을 완전히 피할 수 없습니다. 관리감독자·신호수 지시를 따르세요.</small>'
        : q && q.off > 8 ? '<small>경로에서 벗어났습니다 — 다시 찾는 중</small>' : '');
  }
  card.classList.toggle('evac', !!evac);
  card.innerHTML = `<div class="rc-head"><span>${evac ? '🚨 대피 경로' : '🧭 안전 경로'} → <b>${esc(A.dest.name)}</b></span><button class="rc-x" data-route-end aria-label="안내 끝내기">✕</button></div>${body}`;
  card.hidden = false;
}
$('routeCard').addEventListener('click', e => { if (e.target.closest('[data-route-end]')) clearRoute(); });

/** 관리감독자 대피 지시 → 가까운 대피 장소 3곳 중 경로가 가장 짧은 곳으로 자동 안내 */
function startEvacuation() {
  if (meDriving()) return;   // 장비 운전 중이면 장비를 멈추는 것이 먼저 (내려서 걸으면 안내)
  const ev = A.places.filter(p => p.kind === 'assembly');
  if (!ev.length) return;
  setTab('map');
  if (!A.est) { setDest(ev[0], true); return; }
  const cand = ev.map(p => ({ p, d: Math.hypot(p.x - A.est.x, p.y - A.est.y) })).sort((a, b) => a.d - b.d).slice(0, 3);
  let best = null;
  for (const c of cand) {
    A.dest = { ...c.p, evac: true }; computeRoute();
    const len = A.route && A.route.metrics ? A.route.metrics.length : Infinity;
    if (!best || len < best.len) best = { p: c.p, len };
  }
  setDest(best.p, true);
  addAlert('danger', '🏃', `대피 경로 안내: ${best.p.name}`);
}

// ═══════════════════════════════════════════════
//  2026-11-22 현장 운영 — 장비 작업 상태 · 작업 일정 · 층 · 쓰러짐 감지 · 대피 점호 · 기준점 보정
// ═══════════════════════════════════════════════

// ── 장비 작업 상태 (운전원) ──
// 2026-11-25 운전원 = 처음엔 「🚶 도보」(일반 근로자 — 내 위험 경보, 대피 안내, 층). 장비에 타서 「이동 · 정지 · 작업」을 고르면 장비로.
//  「작업」을 누르면 위험 반경이 작업 위치에 고정된다(장비를 따라 움직이지 않음 → 근로자가 출입 금지 구역을 알 수 있음):
//  관리자가 배치한 곳에서 「여유 + WORK_TOL」 안이면 그곳, 아니면 지금 위치가 작업 구역(관리자 화면에 기록됨).
function myMarker() { return A.markers.find(x => x.id === A.equipment); }
function renderOpBar() {
  document.querySelectorAll('#opBar [data-op]').forEach(b => b.classList.toggle('on', b.dataset.op === A.opState));
  if (A.role !== 'operator') {
    $('abRole').textContent = `👷 작업자 · ${A.name}${A.sim ? ' · 시연 모드' : ''}`;
    $('headingBtn').hidden = $('headingMenuBtn').hidden = true; $('indFloor').hidden = false;
    return;
  }
  const eqLabel = (myMarker() || {}).label || '';
  $('abRole').textContent = `${meDriving() ? `🚜 ${eqLabel} 운전` : `🚶 운전원(${eqLabel}) · 도보`} · ${A.name}${A.sim ? ' · 시연 모드' : ''}`;
  $('headingBtn').hidden = $('headingMenuBtn').hidden = !meDriving();
  $('indFloor').hidden = meDriving();
}
function setOpState(st, why) {
  if (!OP_STATES[st] || st === A.opState) return;
  const was = meDriving();
  if (st === 'work') {
    const m = myMarker(), pad = workPadOf(m), d = m && A.est ? Math.hypot(A.est.x - m.x, A.est.y - m.y) : 0;
    A.workAt = m && A.est && d > pad + WORK_TOL ? { x: +A.est.x.toFixed(2), y: +A.est.y.toFixed(2) } : null;
    why = why || (A.workAt ? `배치된 작업 위치에서 ${Math.round(d)} m — 지금 위치를 작업 구역으로 정했습니다` : '배치된 작업 구역에 위험 반경을 고정합니다');
  } else A.workAt = null;
  LS.set('socmap.field.workAt', JSON.stringify(A.workAt));
  if (st === 'walk' && A.est && was) A.eqPose = { x: A.est.x, y: A.est.y, heading: A.heading };
  A.opState = st; A.opMoveS = 0; A.opOutS = 0;
  LS.set('socmap.field.opState', st);
  if (was !== meDriving()) {   // 근로자 ↔ 장비: 경보 상태를 새로 시작
    A.intrusions = []; A.near = []; A.conflicts = []; A.tracker = new SafetyTracker(); A.shown = null; stopAlarm();
    $('intrusions').hidden = true;
  }
  if (meDriving() && A.dest && !A.dest.evac) clearRoute();   // 장비에 타면 걷는 길 안내는 끝냄
  renderOpBar(); rebuildField(); evaluate(); renderRoute(); requestRender(); send(true);
  if (A.tab === 'more') renderMore();
  addAlert(st === 'travel' ? 'warning' : 'info', OP_STATES[st].icon, `${st === 'walk' ? '' : '장비 상태: '}${OP_STATES[st].label}${why ? ` — ${why}` : ''}`);
}
$('opBar').addEventListener('click', e => { const b = e.target.closest('[data-op]'); if (b) setOpState(b.dataset.op); });
/** 「정지·대기」인데 3초 넘게 움직이면 「이동 중」으로 올린다 (위험을 낮추는 쪽으로는 저절로 바꾸지 않음).
 *  2026-11-25 「작업 중」인데 장비가 작업 구역(여유 + WORK_TOL)을 3초 넘게 벗어나면 「이동 중」 — 고정된 위험 구역이 장비를 놓치지 않게 */
function autoOpState() {
  if (A.role !== 'operator' || !A.est) return;
  if (A.opState === 'work' && A.field) {
    const eq = A.field.equipments.find(e => e.marker._mine), out = eq ? eq.outOfZone() : 0;
    A.opOutS = out > WORK_TOL + Math.min(5, A.sim ? 0 : A.est.sigma || 0) ? A.opOutS + 1 : 0;
    if (A.opOutS >= 3) { setOpState('travel', `작업 구역에서 ${Math.round(out)} m 벗어났습니다. 새 자리에서 「작업」을 누르면 그곳이 작업 구역`); alarm('warning'); return; }
  }
  if (A.sim) return;
  A.opMoveS = A.est.speed > 1.2 ? A.opMoveS + 1 : 0;
  if (A.opState === 'idle' && A.opMoveS >= 3) { setOpState('travel', '장비가 움직여 바꿨습니다'); alarm('warning'); }
}

// ── 작업 일정: 켜지고 꺼질 때 알림 ──
function checkSchedules() {
  if (!A.site) return;
  const objs = [...A.markers, ...((A.site.doc.siteEnvironment || {}).envZones || [])].filter(o => scheduleValid(o.schedule));
  if (!objs.length) return;
  const now = siteNow(), on = objs.map(o => scheduleActive(o.schedule, now));
  const sig = on.map(Number).join('');
  if (A.schedSig !== null && sig !== A.schedSig) {
    const prev = A.schedSig;
    objs.forEach((o, i) => {
      if (+prev[i] === +on[i]) return;
      const name = o.label || (ENV_ZONE_TYPES[o.type] || {}).label || '구역';
      if (o.isEquipment) addAlert(on[i] ? 'warning' : 'info', '⏰', `${name} 작업 시간 ${on[i] ? '시작' : '끝'} (${scheduleText(o.schedule)})`);
      else addAlert(on[i] ? 'warning' : 'info', '⏰', `${name} ${on[i] ? '켜짐 — 들어가지 마세요' : '해제'} (${scheduleText(o.schedule)})`);
    });
    if (on.some((v, i) => v && !+prev[i])) alarm('warning');
    rebuildField(); evaluate(); requestRender();
  }
  A.schedSig = sig;
}

// ── 층 ──
function hasBaro() { return PWA.native && window.SOCMAPNative && typeof window.SOCMAPNative.pressure === 'function'; }
function renderFloor() {
  const t = A.floor == null ? '층?' : floorText(A.floor);
  $('indFloor').querySelector('span').textContent = `🏢 ${t}${A.floorPick === 'auto' && hasBaro() ? '' : ''}`;
  $('indFloor').classList.toggle('warn', A.floor == null);
}
function setFloor(f) {
  if (f === A.floor) return;
  A.floor = f; renderFloor(); rebuildField(); evaluate(); requestRender(); send(true);
}
/** 건물 밖이고 건물에서 8 m 넘게 떨어져 있나 (비계 위가 아닌 진짜 지상) — 기압 기준을 다시 맞출 때만 쓴다 */
function clearlyOutside() {
  if (!A.est || A.est.sigma > 10) return false;
  return !A.contourPolys.some(p => p.length >= 6 && distanceToPolygon(A.est.x, A.est.y, p) < 8);
}
function updateFloor() {
  if (meDriving()) return;
  if (A.floorPick !== 'auto') { setFloor(+A.floorPick); return; }
  if (!hasBaro()) { setFloor(null); return; }
  let p = -1;
  try { p = +window.SOCMAPNative.pressure(); } catch (e) { p = -1; }
  if (!(p > 0)) { setFloor(null); return; }
  setFloor(A.baro.update(p, clearlyOutside(), Date.now()));
}
function openFloor() {
  const opts = [['auto', hasBaro() ? '자동 (기압)' : '모름'], ['-2', '지하 2층'], ['-1', '지하 1층'], ['0', '지상'],
    ...Array.from({ length: 12 }, (_, i) => [String(i + 1), `${i + 1}층`])];
