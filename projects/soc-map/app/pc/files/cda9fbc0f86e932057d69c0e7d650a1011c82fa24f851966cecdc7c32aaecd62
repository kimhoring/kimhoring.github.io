async function lookupCode() {
  const code = $('codeInput').value.trim().toUpperCase();
  A.site = null; $('err1').textContent = ''; validate();
  if (code.length < 6) return false;
  try {
    const r = await fetch('/api/join', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code }) });
    const p = await r.json();
    if (!r.ok) throw new Error(p.detail);
    A.code = code; A.project = p;
    applyPolicy(p.policy);
    await loadSite();
    const eqs = A.markers.filter(m => m.isEquipment);
    $('projectCard').innerHTML = `<b>✅ ${esc(p.name)}</b><span class="meta">현재 접속 ${p.online}명 · 장비 ${eqs.length}대 · ${p.origin.lat.toFixed(4)}, ${p.origin.lon.toFixed(4)}</span>`;
    validate();
    return true;
  } catch (e) {
    $('err1').textContent = e instanceof TypeError ? '서버에 연결할 수 없습니다. 노트북 서버가 켜져 있는지 확인하세요.' : e.message || '참여 코드를 확인하세요.';
