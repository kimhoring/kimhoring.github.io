// ── 쓰러짐 감지 ──
function startMotion() {
  if (A._motion) return;
  A._motion = true;
  window.addEventListener('devicemotion', onMotion);
  try {   // iOS: 버튼(현장 합류)을 누른 흐름 안에서 권한을 물어야 함
    if (typeof DeviceMotionEvent !== 'undefined' && DeviceMotionEvent.requestPermission) DeviceMotionEvent.requestPermission().catch(() => {});
  } catch (e) { /* 미지원 */ }
}
function onMotion(e) {
  if (!A.running || !A.fallOn || A.fallTimer) return;
  const a = e.accelerationIncludingGravity;
  if (!a || a.x == null) return;
  if (A.fallDet.push(Math.hypot(a.x, a.y, a.z), Date.now())) fallSuspected();
}
function fallSuspected() {
  if (A.fallTimer) return;
  let left = FALL.RESPOND_S;
  $('fallCount').textContent = left;
  $('fallOverlay').hidden = false;
  addAlert('danger', '🆘', '쓰러짐이 의심됩니다 — 응답을 기다리는 중');
  PWA.notify('🆘 괜찮으세요?', { body: `${FALL.RESPOND_S}초 안에 「괜찮아요」를 누르지 않으면 자동으로 SOS가 갑니다.`, tag: 'fall', requireInteraction: true });
  const ring = () => { for (let i = 0; i < 3; i++) { beep(1300, 0.18, i * 0.4); beep(800, 0.18, i * 0.4 + 0.2); } vibrate([600, 200, 600]); };
  ring();
  A.fallTimer = setInterval(() => {
    left--; $('fallCount').textContent = Math.max(0, left);
    if (left % 5 === 0) ring();
    if (left <= 0) { fallDone(); sendSos('fall'); addAlert('danger', '🆘', '응답이 없어 자동으로 SOS를 보냈습니다.'); }
  }, 1000);
}
function fallDone() { clearInterval(A.fallTimer); A.fallTimer = null; $('fallOverlay').hidden = true; }
$('fallOkBtn').addEventListener('click', () => { fallDone(); addAlert('info', '✅', '괜찮다고 응답했습니다.'); });
$('fallSosBtn').addEventListener('click', () => { fallDone(); sendSos('fall'); });
$('fallToggle').checked = A.fallOn;
$('fallToggle').addEventListener('change', e => { A.fallOn = e.target.checked; LS.set('socmap.field.fall', A.fallOn ? '1' : '0'); });

