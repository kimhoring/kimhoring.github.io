function zoomBtnLook(m) {
  const b = $('zoomBtn'), follow = m === 'follow';
  b.textContent = follow ? '🗺️' : '🎯'; b.dataset.label = follow ? '현장 전체' : '내 위치'; b.title = follow ? '현장 전체 보기' : '내 위치 따라가기';
}
