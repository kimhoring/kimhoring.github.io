  $('err3').textContent = '';
  if (!A.sim && !PWA.native) {   // 안드로이드 앱은 휴대폰 GPS 를 직접 쓰므로 주소(HTTPS) 제한이 없다
    if (!('geolocation' in navigator)) { goStep(2); $('err3').textContent = '이 브라우저는 위치 기능을 지원하지 않습니다.'; return; }
    if (!window.isSecureContext) {
