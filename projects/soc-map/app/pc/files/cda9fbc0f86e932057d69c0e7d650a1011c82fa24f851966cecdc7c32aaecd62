// ═══════════════════════════════════════════════
//  현장 정보
// ═══════════════════════════════════════════════

async function loadSite() {
  const res = await fetch(`/api/projects/${A.project.id}/site?code=${A.code}`, { cache: 'no-store' });
  const site = await res.json();
  if (!res.ok) throw new Error(site.detail || '현장 배치를 불러오지 못했습니다.');
  A.site = site;
  _frame = new LocalFrame(site.origin.lat, site.origin.lon);
  A.places = site.places || [];
  if (site.policy) applyPolicy(site.policy);
  A.markers = site.doc.markers || [];
  A.contourPolys = (site.doc.contours || []).map(flattenContour);
  A.plan = site.phonePlan || null;
  if (site.planVersion && A.plan) {
    const img = new Image();
    img.onload = () => { A.planImg = img; requestRender(); };
    img.src = `/api/projects/${A.project.id}/plan?code=${A.code}&v=${site.planVersion}`;
  } else A.planImg = null;
  rebuildField();
}

/** 장비 목록 = 관리자 배치 + 운전원 휴대폰의 실시간 위치 */
function liveMarkers() {
  return A.markers.map(m => {
    const plan = { x: m.x, y: m.y };
    if (A.role === 'operator' && m.id === A.equipment && A.est) {
      const walk = A.opState === 'walk', P = walk ? (A.eqPose || { x: m.x, y: m.y, heading: m.heading || 0 }) : { x: A.est.x, y: A.est.y, heading: A.heading };
      return { ...m, x: P.x, y: P.y, heading: P.heading, label: m.label + (walk ? ' (내 장비 · 정지)' : ' (내 장비)'), _mine: true, _plan: plan,
        _workAt: A.opState === 'work' ? A.workAt : null, _liveState: A.opState, _v: walk ? {} : { vx: A.est.vx || 0, vy: A.est.vy || 0 } };
    }
    const op = A.peers.find(p => p.role === 'operator' && p.equipment === m.id && p.online !== false && p.x != null && p.id !== myId());
    if (!op) return m;
    const P = equipPoseOf(op, m);
    return { ...m, x: P.x, y: P.y, heading: P.heading, label: `${m.label} (${P.walk ? '정지 · 운전원 하차' : op.op_state === 'work' ? '작업 중' : '운행 중'})`, _live: true, _by: op.name,
      _plan: plan, _workAt: P.workAt, _liveState: op.op_state, _v: P.v };
  });
}
/** 2026-11-25 운전원이 지금 장비에 타 있는가 — 「도보」면 일반 근로자처럼 위험을 본다 */
function meDriving() { return A.role === 'operator' && A.opState !== 'walk'; }
function rebuildField() {
  if (!A.site) return;
  if (meDriving() && A.est) A.eqPose = { x: A.est.x, y: A.est.y, heading: A.heading };   // 내리면 장비는 이 자리에
  // 사람마다: 내 층(위층이면 지상 장비 제외) · 내 이름(출입 허가). 장비를 운전 중이면 모든 위험을 본다
  A.field = new RiskField(liveMarkers(), A.site.doc.siteEnvironment || { windSpeed: 0, envZones: [] },
    meDriving() ? {} : { floor: A.floor, person: A.name });
}

// ═══════════════════════════════════════════════
//  서버 연결
// ═══════════════════════════════════════════════

function connect() {
  const q = new URLSearchParams({ code: A.code, id: myId(), name: A.name, role: A.role, sim: A.sim ? 1 : 0 });
  if (A.equipment) q.set('equipment', A.equipment);
  const ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws/p/${A.project.id}/client?${q}`);
  A.ws = ws;
  let opened = false;
  ws.onopen = () => {
    opened = true;
    if (A.wsRetry > 0) addAlert('info', '🔌', '서버 연결이 복구되었습니다.');
    A.connected = true; A.wsRetry = 0; A.lostShown = false; renderIndicators(); send(true);
  };
  ws.onmessage = (e) => {
    const msg = JSON.parse(e.data);
    if (A.ws !== ws) return;
    if (msg.type === 'hello' || msg.type === 'peers') {
      A.peers = msg.peers || [];
      if (msg.type === 'hello') {
        applyPolicy(msg.policy); if (msg.places) A.places = msg.places;
        if (msg.corr) setCorr(msg.corr);
        if (msg.evac && msg.evac.active && !A.evac) { A.evac = { state: msg.evac.state || 'moving' }; renderEvac(); }
      }
      rebuildField(); evaluate(); requestRender(); if (A.tab === 'near') renderNear(); renderIndicators();
    }
    else if (msg.type === 'site') loadSite().then(() => { evaluate(); requestRender(); A.routeSig = ''; addAlert('info', '🔄', '관리자가 현장 배치를 갱신했습니다.'); }).catch(() => {});
    else if (msg.type === 'policy') { applyPolicy(msg.policy); addAlert('info', '⚙️', '관리감독자가 앱 설정을 바꿨습니다.'); }
    else if (msg.type === 'sos_sent') {
      const where = msg.location ? `${msg.location}${msg.acc >= 1 ? ` (±${Math.round(msg.acc)} m)` : ''}` : '위치 정보 없음 — GPS를 아직 못 잡았습니다';
      addAlert('danger', '🆘', `SOS 전달됨 · 📍 ${where}`);
      showMessage({ text: `관리감독자에게 긴급 호출을 보냈습니다.\n📍 전달된 위치: ${where}\n안전한 곳에서 기다리세요.`, local: true });
    }
    else if (msg.type === 'sos_ack') {
      addAlert('info', '✅', '관리감독자가 긴급 호출을 확인했습니다.');
      showMessage({ text: '관리감독자가 긴급 호출을 확인했습니다.\n도움이 가고 있습니다. 가능하면 그 자리에서 기다리세요.', local: true });
    }
    else if (msg.type === 'corr') setCorr(msg.corr);
    else if (msg.type === 'evac_status') {
      if (msg.state === 'arrived') { A.evac = { state: 'arrived', place: msg.place }; addAlert('info', '✅', `대피 도착이 확인되었습니다${msg.place ? ` — ${msg.place}` : ''}.`); beep(990, 0.12); beep(1320, 0.18, 0.15); }
      else if (msg.state === 'ended') { if (A.evac) addAlert('info', '🏁', '관리감독자가 대피를 끝냈습니다.'); A.evac = null; }
      renderEvac();
    }
    else if (msg.type === 'places') { A.places = msg.places || []; if (A.dest && A.dest.id && !A.places.some(p => p.id === A.dest.id)) clearRoute('목적지가 삭제되었습니다.'); requestRender(); }
    else if (msg.type === 'message') {
      addAlert(msg.level === 'evacuate' ? 'danger' : 'info', msg.level === 'evacuate' ? '🚨' : '📢', `관리자: ${msg.text}`);
      showMessage(msg);
      if (msg.level === 'evacuate') { if (!A.evac || A.evac.state === 'arrived') A.evac = { state: 'moving' }; renderEvac(); startEvacuation(); }
    }
  };
  ws.onclose = (e) => {
    if (A.ws !== ws) return;   // 새 연결로 교체된 이전 연결
    const was = A.connected;
    A.connected = false; renderIndicators();
    if (e.code === 4409) {   // 재연결하지 않음
      showMessage({ text: '이 현장은 시연 모드를 허용하지 않습니다.\n「현장 나가기」 후 시연 모드를 끄고 다시 합류하세요.', level: 'evacuate', local: true });
      return;
    }
    // 안내는 끊길 때마다가 아니라 한 번만 (재시도는 계속)
    if (!A.lostShown && (e.code === 4403 || (!opened && A.wsRetry > 3))) {
      A.lostShown = true;
      showMessage({ local: true, alt: PWA.native ? { label: '📷 새 QR 찍기', run: goServerHome } : null,
        text: e.code === 4403 ? '참여 코드가 바뀌었습니다. 관리자에게 새 QR이나 초대 링크를 받으세요.'
          : `현장 서버에 연결되지 않습니다. 위험 경보가 오지 않을 수 있으니 주의하세요.\n${Directory.enabled() ? '노트북이 다시 켜지면 저절로 이어집니다.' : '노트북을 다시 켰다면 주소가 바뀌었으니 새 QR을 찍거나 새 초대 링크를 누르세요.'}` });
    }
    if (was) addAlert('warning', '📵', '서버 연결이 끊겼습니다. 자동으로 다시 연결합니다.');
    if (A.running) setTimeout(() => { if (A.running) connect(); }, Math.min(10000, 1000 * 2 ** A.wsRetry++));
    if (A.wsRetry >= 2) followServer();
  };
  ws.onerror = () => ws.close();
}

// v14.10 노트북을 다시 켜 주소가 바뀌면 안내판을 보고 저절로 따라간다 (같은 주소로 돌아오면 위의 재연결로 끝)
let _followTimer = null;
function followServer() {
  if (_followTimer || !Directory.enabled()) return;
  _followTimer = setInterval(async () => {
    if (!A.running || A.connected) { clearInterval(_followTimer); _followTimer = null; return; }
    const url = await Directory.find();
    if (!url || url === location.origin || !A.running || A.connected) return;
    const who = PWA.native ? '' : '#who=' + encodeURIComponent(JSON.stringify({ id: A.id, name: A.name, role: A.role, equipment: A.equipment || '' }));
    PWA.open(`${url}/j/${A.code}${who}`);
  }, 10000);
}

function send(force = false) {
  if (!A.ws || A.ws.readyState !== 1 || !A.est) return;
  const drive = meDriving(), now = Date.now(), lv = drive ? 'safe' : A.tracker.level;
  const urgent = lv === 'danger' || lv === 'warning' || A.intrusions.length || drive;
  const rawLv = A.assess ? A.assess.level : null;   // 작업자 화면 경보는 확정 전 단계로 즉시 울린다 → 시험 분석용으로 함께 보고
  // 현장 밖(2026-11-24): 20초에 한 번만(서버 신호 끊김 30초 전) — 위치는 서버가 공유하지 않음. 현장에 들어오는 순간은 바로 보냄
  const out = A.inside === false, entered = A.lastSentOut && !out;
  if (!force && !entered && lv === A.lastSentLevel && rawLv === A.lastSentRaw && now - A.lastSentAt < (out ? 20000 : urgent ? 1000 : 3000)) return;
  const ll = _frame.toLatLon(A.est.x, A.est.y);
  const msg = { type: 'pos', lat: ll.lat, lon: ll.lon, acc: A.raw ? A.raw.acc : null, sigma: +A.est.sigma.toFixed(2),
    speed: +A.est.speed.toFixed(2), level: lv, battery: A.battery ? Math.round(A.battery.level * 100) : null, client_ts: now,
    vx: +(A.est.vx || 0).toFixed(2), vy: +(A.est.vy || 0).toFixed(2), floor: drive ? null : A.floor };
  if (A.raw && A.raw.lat != null) Object.assign(msg, { raw_lat: A.raw.lat, raw_lon: A.raw.lon });
  if (A.role === 'operator') {   // 도보여도 상태(walk)는 알림 → 서버·관리자가 장비를 그 자리에 정지로, 나를 근로자로 본다
    msg.op_state = A.opState;
    msg.intrusions = drive ? A.intrusions.map(i => i.id) : []; msg.conflicts = drive ? A.conflicts.map(c => c.text) : [];
    if (drive) msg.heading = Math.round(headingToBearing(A.heading));
    if (A.opState === 'work' && A.workAt) { const w = _frame.toLatLon(A.workAt.x, A.workAt.y); msg.work_at = [w.lat, w.lon]; }   // 운전원이 정한 작업 위치
  }
  if (!drive && A.assess) Object.assign(msg, { risk: A.assess.risk, nearest_m: A.assess.nearestDangerM, source: A.assess.source, raw_level: rawLv });
