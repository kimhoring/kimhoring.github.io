// 1-1. GPS 로 주변 현장 찾기 → 현장 근처면 참여 코드 없이 합류 (서버가 위치를 확인하고 코드를 발급)
const GEO_ERR = { 1: '위치 권한이 거부되었습니다. 브라우저 설정에서 이 사이트의 위치 권한을 허용하세요.', 2: 'GPS 신호를 찾을 수 없습니다. 하늘이 보이는 곳으로 이동하세요.', 3: 'GPS 응답 시간 초과' };
const postJson = async (url, body) => {
  const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const d = await r.json();
  if (!r.ok) throw new Error(d.detail || '요청 실패');
