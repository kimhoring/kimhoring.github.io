  LS.set('socmap.field.consent', '1'); LS.set('socmap.field.code', A.code); LS.set('socmap.field.consentCode', A.code); LS.set('socmap.field.left', '');
  saveProfile();
  unlockAudio();
  A.filter = new GpsFilter(A.role === 'operator' ? 0.6 : 1.0);
  if (A.role === 'operator') {
    const m = A.markers.find(x => x.id === A.equipment); A.heading = m ? m.heading || 0 : 0;
    // 2026-11-25 다른 현장·장비로 새로 합류하면 「도보」부터 (같은 장비로 다시 들어오면 하던 상태 그대로)
