// ═══════════════════════════════════════════════
//  위치 · 방향
// ═══════════════════════════════════════════════

function startGps() {
  A.watchId = navigator.geolocation.watchPosition(p => {
    const c = p.coords, loc = _frame.toLocal(c.latitude, c.longitude);
    A.raw = { lat: c.latitude, lon: c.longitude, acc: c.accuracy, t: p.timestamp, err: null };
    const k = corrNow();
    if (k) { loc.x -= k.dx; loc.y -= k.dy; }   // 기준점 보정 — 기준 휴대폰이 잰 공통 오차를 뺌 (보고하는 raw_lat/lon 은 그대로)
    if (c.accuracy > 60) { renderIndicators(); return; }   // 너무 부정확한 측위는 위험 판단에 쓰지 않음
    A.est = A.filter.update(loc.x, loc.y, c.accuracy, p.timestamp);
    A.lastFixAt = Date.now();
    updateHeadingFromMotion();
    rebuildField(); evaluate(); requestRender(); send();
  }, err => {
    const m = { 1: '위치 권한이 거부되었습니다. 브라우저 설정에서 이 사이트의 위치 권한을 허용하세요.', 2: 'GPS 신호를 찾을 수 없습니다. 하늘이 보이는 곳으로 이동하세요.', 3: 'GPS 응답 시간 초과' }[err.code] || err.message;
    A.raw = { ...(A.raw || {}), err: m };
    renderIndicators();
    if (err.code === 1) renderStatus('#64748b', '📍 위치 권한 필요', m, '', false);
  }, { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 });
}

function startSim() {
  const m = A.role === 'operator' && A.markers.find(x => x.id === A.equipment);
  const e = A.site.extent;
  setSimPos(m ? m.x : e.minX + e.w * 0.1, m ? m.y : e.maxY - e.h * 0.1);
}
function setSimPos(x, y) {
  if (A.est && meDriving() && Math.hypot(x - A.est.x, y - A.est.y) > 0.5) A.heading = Math.atan2(y - A.est.y, x - A.est.x);
  A.est = { x, y, vx: 0, vy: 0, speed: 0, sigma: 0.3 };
  A.raw = { acc: 0.3 }; A.lastFixAt = Date.now();
  rebuildField(); evaluate(); requestRender(); send(true);
}

function updateHeadingFromMotion() {
  if (!meDriving()) return;
  if (A.compass && A.compassHeading != null) { A.heading = bearingToHeading(A.compassHeading); A.headingSrc = 'compass'; return; }
  if (A.est.speed > 0.8) { A.heading = Math.atan2(A.est.vy, A.est.vx); A.headingSrc = 'gps'; }
}
function onOrientation(e) {
