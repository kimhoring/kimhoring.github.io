$('zoomInBtn').addEventListener('click', () => map.zoomCenter(1.6));
$('zoomOutBtn').addEventListener('click', () => map.zoomCenter(1 / 1.6));

function setChip() {
  const t = A.picking ? '🧭 목적지를 지도에서 누르세요 (취소: 🧭 버튼)' : A.sim ? '시연 모드: 지도를 눌러 내 위치를 옮기세요' : '';
  $('chip').textContent = t; $('chip').hidden = !t;
}
function onMapTap(w) {
  if (!A.running) return;
  if (A.picking) { setDest({ name: '지도에서 고른 지점', kind: 'point', x: w.x, y: w.y }); return; }
  if (A.sim) setSimPos(w.x, w.y);
}

function draw() {
  if ($('main').hidden || A.tab !== 'map' || !A.site || !A.field) return;
  if (!map._sized && !map.resize()) return;
  map.frame(A.site.extent, A.est);
  const vis = map.begin(), g = map.g, px = (n) => map.px(n);
  map.basemap(vis);
  $('attr').textContent = Basemap.attribution();
  map.plan(A.planImg, A.plan, 0.7);
  map.siteLayers(A.site, A.contourPolys);
  map.equipment(A.field);
  map.places(A.places, A.dest && A.dest.id);
  if (A.route && A.route.path) map.route(remainingPath(), A.dest && A.dest.evac ? '#ef4444' : '#3b82f6');
  if (A.dest && !A.dest.id) map.emoji('🏁', A.dest.x, A.dest.y - px(10), 24);
  // 다른 작업자
  for (const p of A.peers) {
    if (p.id === myId() || isDriving(p) || p.x == null || p.online === false) continue;
    map.person(p.x, p.y, { color: LEVELS[p.level || 'safe'].color, label: p.role === 'operator' ? `${p.name} (운전원·도보)` : p.name });
  }
  // 나 (작업자 · 장비에서 내린 운전원)
  if (A.est && !meDriving()) {
    if (A.assess) {
      g.beginPath(); g.arc(A.est.x, A.est.y, A.assess.warnRadius || SAFETY.WARN_M, 0, Math.PI * 2);
      g.strokeStyle = 'rgba(255,255,255,0.4)'; g.lineWidth = px(1.5); g.setLineDash([px(5), px(5)]); g.stroke(); g.setLineDash([]);
      if (A.assess.bearing != null && A.assess.level !== 'danger') {
        const d = A.assess.nearestDangerM, a = A.assess.bearing;
        g.beginPath(); g.moveTo(A.est.x, A.est.y); g.lineTo(A.est.x + d * Math.cos(a), A.est.y + d * Math.sin(a)); g.strokeStyle = '#f97316'; g.lineWidth = px(3); g.stroke();
      }
    }
    map.person(A.est.x, A.est.y, { color: A.assess ? LEVELS[A.assess.level].color : '#60a5fa', label: '나', me: true, sigma: A.sim ? 0 : A.est.sigma });
  }
  map.end();
  map.scale(26);
}

