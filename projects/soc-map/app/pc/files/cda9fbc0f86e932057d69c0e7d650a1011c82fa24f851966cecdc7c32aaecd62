  A.compassHeading = (h + scr) % 360;
}
async function enableCompass(on) {
  A.compass = on;
  if (!on) return;
  try {
    if (typeof DeviceOrientationEvent !== 'undefined' && DeviceOrientationEvent.requestPermission) {
      if (await DeviceOrientationEvent.requestPermission() !== 'granted') throw new Error('권한 거부');
    }
    window.addEventListener('deviceorientationabsolute', onOrientation);
    window.addEventListener('deviceorientation', onOrientation);
  } catch (e) { A.compass = false; $('compassToggle').checked = false; alert('나침반을 사용할 수 없습니다: ' + e.message); }
}

function tick() {
  if (meDriving() && A.compass && A.compassHeading != null) { A.heading = bearingToHeading(A.compassHeading); rebuildField(); }
  autoOpState(); updateFloor(); checkSchedules();
  evaluate(); send(); renderIndicators(); requestRender();
  updateRoute();
  if (A.tab === 'near') renderNear();
  if (A.tab === 'more') renderMore();
}

// ═══════════════════════════════════════════════
//  평가 · 경보
// ═══════════════════════════════════════════════

function evaluate() {
  if (!A.est || !A.field) return;
  return meDriving() ? evaluateOperator() : evaluateWorker();
}

/** 도면 정합 오차(m) — 관리자가 도면을 기준점으로 정합할 때 계산해 배치와 함께 보낸다. 도면이 없으면 0 */
function alignErr() { const p = A.site && A.site.doc && A.site.doc.plan; return A.plan && p && p.alignError > 0 ? p.alignError : 0; }
/** 위치 불확실성 = √(GPS 보정 후 오차² + 도면 정합 오차²) → 경고 거리 = 8 m + 이 값(최대 8 m) */
function posSigma() { return Math.hypot(A.sim ? 0 : A.est.sigma, alignErr()); }

/** 2026-11-24 현장 안인가 — 경계(+30 m) 안, 또는 경계 밖이어도 위험 구역이 20 m 안이면 안으로 봄(크레인 붐이 경계 밖으로 나가는 경우) */
function onSite(a) {
  const doc = A.site.doc || {};
  if (siteContains(doc.siteBoundary, A.site.extent, A.est.x, A.est.y)) return true;
  return !!(a && (a.level !== 'safe' || (a.nearestDangerM != null && a.nearestDangerM < 20)));
}

function evaluateWorker() {
  let a = assessSafety(A.field, A.est.x, A.est.y, posSigma(), { vx: A.est.vx || 0, vy: A.est.vy || 0 });
  const inside = onSite(a);
  if (!inside) a = { risk: 0, level: 'safe', nearestDangerM: null, source: '' };
  a.inside = inside; A.inside = inside;
  A.assess = a;
  A.tracker.update(a.level);
  setShown(a.level, a);
  const info = LEVELS[a.level];
  const icon = { safe: '✅', caution: '⚠️', warning: '⚠️', danger: '🚨' }[a.level];
  let msg;
  if (!inside) msg = '공사 현장 밖에 있습니다. 위치는 현장에 들어오면 다시 공유됩니다.';
  else if (a.level === 'danger') msg = '즉시 위험 구역에서 벗어나세요! 관리자에게 알림이 전송됩니다.';
  else if (a.level === 'warning' && a.ttc != null) msg = `장비가 다가옵니다 — 약 ${a.ttc}초 뒤 위험 반경. ${compassName(a.bearing)}쪽을 보고 비키세요.`;
  else if (a.level === 'warning') msg = `위험 구역까지 약 ${a.nearestDangerM}m — ${compassName(a.bearing)}쪽으로 가지 마세요.`;
  else if (a.level === 'caution') msg = '주의 구역입니다. 장비 움직임을 확인하세요.';
  else msg = a.nearestDangerM ? `가장 가까운 위험 구역 약 ${a.nearestDangerM}m` : '주변에 위험 구역이 없습니다.';
  renderStatus(info.color, `${icon} ${inside ? info.label : '현장 밖'}`, msg, a.source ? `원인: ${a.source}` : '', a.level === 'danger');
  $('intrusions').hidden = true;
}

function evaluateOperator() {
  A.inside = siteContains((A.site.doc || {}).siteBoundary, A.site.extent, A.est.x, A.est.y, SITE_MARGIN + 30);
  const me = liveMarkers().find(m => m.id === A.equipment);
  if (!me) { renderStatus('#64748b', '🚜 장비 없음', '관리자가 이 장비를 삭제했습니다. 현장에서 나간 뒤 다시 합류하세요.', '', false); return; }
  const eq = createEquipment(me, A.site.doc.siteEnvironment || {});
  const R = eq.getMaxRadius();
  // 위층에서 일하는 사람은 지상 장비와 무관 (크레인은 모든 층)
  const workers = A.peers.filter(p => !isDriving(p) && p.online !== false && p.x != null && p.id !== myId() && equipmentFloorMatch(me.type, p.floor));
  const zoneName = { full: '전면 통제 구역', red: eq.fixedZone ? '작업 구역·출입 금지' : '작업 반경', orange: me.type === 'excavator' ? '후방 사각지대' : '경고 구역', normal: '영향권', idle: '장비 본체 곁' };
  A.intrusions = []; A.near = [];
  for (const w of workers) {
    const z = eq.zoneAt(w.x, w.y), d = Math.hypot(w.x - eq.xc, w.y - eq.yc);
    if (z === 'full' || z === 'red' || z === 'orange') { A.intrusions.push({ id: w.id, name: w.name, zone: zoneName[z], d }); continue; }
    const t = closingTime(w.x, w.y, w.vx, w.vy, eq.xc, eq.yc, A.est.vx, A.est.vy, R);   // 서로 다가오는 중
    if (d <= R + SAFETY.WARN_M || (t && t.ttc <= TTC.WARN_S)) A.near.push({ id: w.id, name: w.name, d: d - R, ttc: t && t.ttc <= TTC.WARN_S ? Math.round(t.ttc) : null });
  }
  // 장비끼리 간섭 (내 장비가 낀 것만)
  const prevC = new Set(A.conflicts.map(c => c.text));
  A.conflicts = equipmentConflicts(A.field.equipments).filter(c => c.a.marker._mine || c.b.marker._mine).map(c => ({ text: c.text, level: c.level }));
  for (const c of A.conflicts) if (!prevC.has(c.text)) { addAlert(c.level === 'danger' ? 'danger' : 'warning', '⚠️', `장비 간섭: ${c.text}`); alarm('warning'); }
  const lvl = A.intrusions.length ? 'danger' : A.near.length ? 'warning' : 'safe';
  setShown(lvl, null);
  const head = Math.round(headingToBearing(A.heading));
  const src = { compass: '나침반', gps: 'GPS 이동 방향', manual: '수동 설정' }[A.headingSrc];
  if (A.intrusions.length) renderStatus('#ef4444', `🚨 반경 내 작업자 ${A.intrusions.length}명`, '장비를 멈추고 작업자 위치를 확인하세요!', A.intrusions.map(i => `${i.name} (${i.zone})`).join(', '), true);
  else if (A.near.length) renderStatus('#f97316', `⚠️ 작업자 접근 ${A.near.length}명`, `반경 밖 ${Math.max(0, Math.min(...A.near.map(n => n.d))).toFixed(1)}m 까지 접근`, A.near.map(n => n.name + (n.ttc != null ? ` (${n.ttc}초)` : '')).join(', '), false);
  else if (A.conflicts.length) renderStatus('#f97316', '⚠️ 장비 간섭', A.conflicts[0].text, A.conflicts.length > 1 ? `외 ${A.conflicts.length - 1}건` : '', false);
  else {
    const out = eq.outOfZone();
    const what = eq.fixedZone ? `작업 구역 고정 · 반경 ${R.toFixed(1)}m${A.workAt ? ' (내가 정한 자리)' : ''}` : `${OP_STATES[eq.state].label} · 반경 ${R.toFixed(1)}m`;
    const note = eq.fullControlReason() ? `⛔ ${eq.fullControlReason()}` : out > 0 ? `⚠️ 작업 구역 밖 ${out.toFixed(1)}m — 더 벗어나면 「이동 중」으로 바뀝니다` : '';
    renderStatus('#10b981', '✅ 반경 내 작업자 없음', `${what} · 방향 ${head}° (${src})`, note, false);
  }
  const list = [...A.intrusions.map(i => `<div>🔴 <b>${esc(i.name)}</b> — ${esc(i.zone)} · 장비에서 ${i.d.toFixed(1)}m</div>`),
    ...A.near.map(n => `<div>🟠 ${esc(n.name)} — ${n.ttc != null ? `<b>다가오는 중 · 약 ${n.ttc}초</b>` : `반경까지 ${Math.max(0, n.d).toFixed(1)}m`}</div>`),
    ...A.conflicts.map(c => `<div>${c.level === 'danger' ? '🔴' : '🟠'} ${esc(c.text)}</div>`)];
  $('intrusions').innerHTML = list.join('');
  $('intrusions').hidden = !list.length;
}

function setShown(level, a) {
  if (level === A.shown) return;
  const up = A.shown && LEVELS[level].rank > LEVELS[A.shown].rank;
  const first = !A.shown;
  A.shown = level;
  if (up || (first && level !== 'safe')) {
    alarm(level);
    if (meDriving()) {
      if (level === 'danger') addAlert('danger', '🚨', `장비 반경 안에 작업자: ${A.intrusions.map(i => i.name).join(', ')}`);
      else if (level === 'warning') addAlert('warning', '⚠️', `작업자 접근: ${A.near.map(n => n.name).join(', ')}`);
    } else if (a) {
      if (level === 'danger') addAlert('danger', '🚨', `위험 구역 진입 — ${a.source || ''}`);
      else if (level === 'warning') addAlert('warning', '⚠️', `위험 구역 접근 (${a.nearestDangerM}m) — ${a.source || ''}`);
    }
  }
  if (level !== 'danger') stopAlarm();
}

function renderStatus(color, title, msg, src, flashing) {
  const el = $('status');
  el.style.setProperty('--lv', color); el.classList.toggle('alarm', flashing);
  $('lvText').textContent = title; $('lvMsg').textContent = msg; $('lvSrc').textContent = src;
}

function gpsQuality() {
  if (A.sim) return { cls: 'ok', text: '시연' };
  if (!A.raw) return { cls: '', text: 'GPS 대기' };
  if (A.raw.err) return { cls: 'bad', text: 'GPS 오류' };
  const age = (Date.now() - A.lastFixAt) / 1000;
  if (!A.lastFixAt || age > 15) return { cls: 'bad', text: '신호 없음' };
  const acc = A.raw.acc || 0;
  return acc <= 8 ? { cls: 'ok', text: `±${Math.round(acc)}m` } : acc <= 25 ? { cls: 'warn', text: `±${Math.round(acc)}m` } : { cls: 'bad', text: `±${Math.round(acc)}m` };
}
function renderIndicators() {
  const c = $('indConn'); c.className = 'ind ' + (A.connected ? 'ok' : 'bad'); c.querySelector('span').textContent = A.connected ? '연결' : '끊김';
  const q = gpsQuality(), g = $('indGps'); g.className = 'ind ' + q.cls; g.querySelector('span').textContent = q.text;
}

// ── 알림 기록 ──
function addAlert(level, icon, text) {
  A.alerts.unshift({ ts: Date.now(), level, icon, text });
  A.alerts = A.alerts.slice(0, 100);
  if (A.tab !== 'alerts' && level !== 'info') A.unread++;
  renderAlertBadge();
  if (A.tab === 'alerts') renderAlerts();
}
function renderAlertBadge() { $('alertBadge').hidden = !A.unread; $('alertBadge').textContent = A.unread; }
function renderAlerts() {
  $('alertList').innerHTML = A.alerts.length ? A.alerts.map(a => `
    <div class="card alert-${a.level}" style="--c:${a.level === 'danger' ? '#ef4444' : a.level === 'warning' ? '#f97316' : '#3b82f6'}">
      <span class="ic">${a.icon}</span><div class="body"><b>${esc(a.text)}</b><small>${timeStr(a.ts)}</small></div></div>`).join('')
    : '<div class="empty">아직 알림이 없습니다.</div>';
}

// ── 주변 ──
function renderNear() {
  if (!A.field) return;
  const me = A.est;
  const eqs = A.field.equipments.filter(eq => !eq.marker._mine).map(eq => {
    const d = me ? Math.hypot(me.x - eq.xc, me.y - eq.yc) - eq.getMaxRadius() : null;
    return { eq, d };
  }).sort((a, b) => (a.d ?? 1e9) - (b.d ?? 1e9));
  $('nearEquip').innerHTML = eqs.length ? eqs.map(({ eq, d }) => {
    const inside = d != null && d <= 0, close = d != null && d <= SAFETY.WARN_M;
    const color = eq.isFullControl() || inside ? '#ef4444' : close ? '#f97316' : '#64748b';
    const sub = [eq.marker._live ? `🟢 운행 중 · ${esc(eq.marker._by)}` : '고정 배치', `반경 ${eq.getMaxRadius().toFixed(1)}m`, eq.isFullControl() ? '⛔ 전면 통제' : ''].filter(Boolean).join(' · ');
    return `<div class="card" style="--c:${color}"><span class="ic">${esc(eq.marker.icon || '⚙️')}</span>
      <div class="body"><b>${esc(eq.marker.label.replace(/ \((운행 중|작업 중|내 장비|내 장비 · 정지|정지 · 운전원 하차)\)$/, ''))}</b><small>${sub}</small></div>
      <div class="dist" style="color:${color}">${d == null ? '-' : inside ? '안쪽' : fmtM(d)}<small>${inside ? '위험 반경' : '반경까지'}</small></div></div>`;
  }).join('') : '<div class="empty">등록된 장비가 없습니다.</div>';

  const people = A.peers.filter(p => p.id !== myId() && p.online !== false && p.x != null && !isDriving(p))
    .map(p => ({ p, d: me ? Math.hypot(me.x - p.x, me.y - p.y) : null })).sort((a, b) => (a.d ?? 1e9) - (b.d ?? 1e9));
  $('nearPeople').innerHTML = people.length ? people.map(({ p, d }) => {
    const lv = LEVELS[p.level || 'safe'];
    return `<div class="card" style="--c:${lv.color}"><span class="ic">👷</span><div class="body"><b>${esc(p.name)}</b><small style="color:${lv.color}">${lv.label}</small></div>
      <div class="dist">${fmtM(d)}<small>나와의 거리</small></div></div>`;
  }).join('') : '<div class="empty">주변에 다른 작업 인원이 없습니다.</div>';
  const ops = A.peers.filter(p => p.id !== myId() && p.online !== false && isDriving(p)).length;
  $('nearSummary').textContent = `장비 ${eqs.length}대 (운행 중 ${ops}) · 작업 인원 ${people.length}명`;
}

// ── 더보기 ──
function renderMore() {
  const eqLabel = A.role === 'operator' ? (A.markers.find(m => m.id === A.equipment) || {}).label : '';
  $('meCard').innerHTML = `<span class="ic">${A.role === 'operator' ? '🚜' : '👷'}</span><span><b>${esc(A.name)}</b><small>${A.role === 'operator' ? `장비 운전원 · ${esc(eqLabel)}` : '작업자'}<br>${esc(A.project ? A.project.name : '')}${A.sim ? ' · 시연 모드' : ''}</small></span>`;
  const locked = !!A.policy.alarm_locked;
  $('alarmLocked').hidden = !locked; $('soundRow').hidden = $('vibeRow').hidden = locked;
  $('soundToggle').checked = A.sound; $('vibeToggle').checked = A.vibe;
  $('installHint').textContent = PWA.hint();
  $('layerName').textContent = S.layers.basemap === 'none' ? '끄기' : (basemapDef(S.layers.basemap) || {}).label || '';
  $('headingName').textContent = `${{ compass: '나침반', gps: 'GPS 이동 방향', manual: '수동' }[A.headingSrc]} ${Math.round(headingToBearing(A.heading))}°`;
  const q = gpsQuality(), ll = A.est && _frame ? _frame.toLatLon(A.est.x, A.est.y) : null;
  $('gpsInfo').innerHTML = A.sim ? '시연 모드 — 지도를 눌러 위치를 정합니다.'
    : !A.raw ? 'GPS 신호를 기다리는 중…'
    : A.raw.err ? `⚠️ ${esc(A.raw.err)}`
    : `측위 정확도 <b>±${Math.round(A.raw.acc)}m</b> → 보정 후 <b>±${A.est ? A.est.sigma.toFixed(1) : '-'}m</b><br>
       위치 ${ll ? `${ll.lat.toFixed(6)}, ${ll.lon.toFixed(6)}` : '-'}<br>
       ${alignErr() ? `도면 정합 오차 ±${alignErr().toFixed(1)}m 포함 → 경고 거리 ${(SAFETY.WARN_M + Math.min(SAFETY.MAX_UNCERT_M, posSigma())).toFixed(1)}m<br>` : ''}
       마지막 갱신 ${A.lastFixAt ? Math.round((Date.now() - A.lastFixAt) / 1000) + '초 전' : '-'} · 상태 ${q.text}
       ${corrNow() ? `<br>📡 기준점 보정 중 (동 ${corrNow().dx >= 0 ? '+' : ''}${corrNow().dx.toFixed(1)} m · 남 ${corrNow().dy >= 0 ? '+' : ''}${corrNow().dy.toFixed(1)} m 빼는 중)` : ''}
       ${!meDriving() ? `<br>🏢 층: ${A.floor == null ? '모름 (모든 위험 알림)' : floorText(A.floor)}${A.floorPick === 'auto' && hasBaro() ? ' · 기압 자동' : A.floorPick === 'auto' ? '' : ' · 직접 고름'}` : ''}`;
}
$('soundToggle').addEventListener('change', e => { if (A.policy.alarm_locked) return; A.sound = e.target.checked; LS.set('socmap.field.sound', A.sound ? '1' : '0'); unlockAudio(); });
$('vibeToggle').addEventListener('change', e => { if (A.policy.alarm_locked) return; A.vibe = e.target.checked; LS.set('socmap.field.vibe', A.vibe ? '1' : '0'); });
$('testAlarmBtn').addEventListener('click', () => { unlockAudio(); beep(880, 0.15); beep(880, 0.15, 0.25); vibrate([200, 100, 200]); });

// ── 탭 ──
function setTab(tab) {
  A.tab = tab;
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('on', t.dataset.tab === tab));
  document.querySelectorAll('.tab-pane').forEach(p => { p.hidden = p.dataset.tab !== tab; });
  if (tab === 'map') resizeMap();
  if (tab === 'near') renderNear();
  if (tab === 'alerts') { A.unread = 0; renderAlertBadge(); renderAlerts(); }
  if (tab === 'more') renderMore();
}
document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => setTab(t.dataset.tab)));

// ── 소리 · 진동 ──
function unlockAudio() { try { A.audio = A.audio || new (window.AudioContext || window.webkitAudioContext)(); A.audio.resume(); } catch (e) { A.audio = null; } }
function beep(freq, dur, when = 0, vol = 0.35) {
  if (!A.sound || !A.audio) return;
  const t = A.audio.currentTime + when, o = A.audio.createOscillator(), g = A.audio.createGain();
  o.type = 'square'; o.frequency.setValueAtTime(freq, t);
  g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(0.001, t + dur);
  o.connect(g).connect(A.audio.destination); o.start(t); o.stop(t + dur);
}
function vibrate(p) { if (!A.vibe) return; try { navigator.vibrate && navigator.vibrate(p); } catch (e) { /* noop */ } }
function alarm(level) {
  // 화면이 꺼져 있으면 브라우저 진동이 막히므로 휴대폰 알림(안드로이드 앱: 경보 채널 진동)으로도 알린다
  if (document.hidden && (level === 'danger' || level === 'warning')) {
    PWA.notify(level === 'danger' ? '🚨 위험 구역 진입' : '⚠️ 위험 구역 접근',
      { body: level === 'danger' ? '즉시 위험 구역에서 벗어나세요.' : '장비 위험 반경에 가까워지고 있습니다.', tag: 'level', requireInteraction: level === 'danger' });
  }
  if (level === 'warning') { beep(880, 0.15); beep(880, 0.15, 0.25); vibrate([200, 100, 200]); }
  else if (level === 'caution') { beep(660, 0.12); vibrate(120); }
  else if (level === 'danger') {
    const siren = () => { for (let i = 0; i < 3; i++) { beep(1100, 0.22, i * 0.5); beep(700, 0.22, i * 0.5 + 0.25); } vibrate([500, 150, 500, 150, 500]); };
    siren(); stopAlarm(); A.alarmTimer = setInterval(siren, 3000);
  }
}
function stopAlarm() { clearInterval(A.alarmTimer); A.alarmTimer = null; }

async function keepAwake() { try { if ('wakeLock' in navigator) A.wakeLock = await navigator.wakeLock.request('screen'); } catch (e) { /* 미지원 */ } }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && A.running) { keepAwake(); unlockAudio(); } });

// ── SOS: 1.2초 길게 누르기 ──
let sosTimer = null, sosStart = 0;
const sosBtn = $('sosBtn');
sosBtn.addEventListener('pointerdown', e => {
  e.preventDefault(); sosStart = Date.now();
  sosTimer = setInterval(() => {
    const p = Math.min(1, (Date.now() - sosStart) / 1200);
    sosBtn.style.setProperty('--p', p * 100);
    if (p >= 1) { sosUp(); sendSos(); }
  }, 30);
});
const sosUp = () => { clearInterval(sosTimer); sosTimer = null; sosBtn.style.setProperty('--p', 0); };
sosBtn.addEventListener('pointerup', sosUp);
sosBtn.addEventListener('pointerleave', sosUp);
sosBtn.addEventListener('contextmenu', e => e.preventDefault());
function sendSos(reason) {
  vibrate([100, 50, 100]);
  if (A.ws && A.ws.readyState === 1) {
    send(true); A.ws.send(JSON.stringify({ type: 'sos', reason: reason || null }));   // 최신 위치를 먼저 보내고 호출 → 서버가 위치 설명을 붙여 관리감독자에게
    showMessage({ text: '긴급 호출을 보내는 중…', local: true });
  } else showMessage({ text: '서버에 연결되어 있지 않아 SOS를 보내지 못했습니다.\n전화 등 다른 방법으로 관리자에게 알리세요.', level: 'evacuate', local: true });
}

// ── 메시지 대화상자 ──
function showMessage(msg) {
  const ov = $('msgOverlay');
  ov.classList.toggle('evacuate', msg.level === 'evacuate');
