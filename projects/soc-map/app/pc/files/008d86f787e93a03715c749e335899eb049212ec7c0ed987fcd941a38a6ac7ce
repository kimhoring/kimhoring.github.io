/* SOC-MAP 현장 앱 (휴대폰) */
:root {
  --bg: #0a0f1c; --surface: #111a2e; --surface-2: #17223a; --line: rgba(148,163,184,.18);
  --text: #e8eef9; --text-2: #b6c2d9; --muted: #8392ad; --primary: #3b82f6; --lv: #10b981;
  --danger: #ef4444; --ok: #10b981; --warn: #f59e0b;
  --safe-b: env(safe-area-inset-bottom); --tabbar-h: 62px;
}
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; background: var(--bg); color: var(--text); font-family: "Pretendard","Segoe UI","Malgun Gothic",-apple-system,sans-serif; font-size: 15px; }
body { overflow: hidden; }
button, select, input { font: inherit; color: inherit; }
button { cursor: pointer; }
[hidden] { display: none !important; }
.screen { position: fixed; inset: 0; display: flex; flex-direction: column; max-width: 560px; margin: 0 auto; background: var(--bg); }

/* ── 공통 ── */
.input { width: 100%; padding: 14px; font-size: 17px; border-radius: 12px; border: 1px solid var(--line); background: #0d1526; outline: none; }
.input:focus { border-color: #60a5fa; }
.label { display: block; font-size: 13.5px; color: var(--muted); margin: 14px 0 6px; font-weight: 600; }
.lead { font-size: 14.5px; color: var(--text-2); line-height: 1.6; }
.btn-primary { width: 100%; padding: 15px; font-size: 17px; font-weight: 800; border-radius: 14px; border: none; background: var(--primary); color: #fff; }
.btn-primary:disabled { opacity: .4; }
.btn-ghost { width: 100%; padding: 14px; font-size: 15px; border-radius: 14px; border: 1px solid var(--line); background: transparent; color: var(--text-2); }
.err { color: #fca5a5; font-size: 14px; line-height: 1.55; white-space: pre-line; margin-top: 10px; }
.err:empty { display: none; }
.check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.55; color: var(--text-2); margin-top: 14px; }
.check input { width: 22px; height: 22px; margin-top: 1px; flex-shrink: 0; accent-color: var(--primary); }
.switch { position: relative; width: 46px; height: 26px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; position: absolute; }
.switch .sl { position: absolute; inset: 0; background: #334155; border-radius: 26px; transition: .2s; }
.switch .sl::before { content: ''; position: absolute; width: 20px; height: 20px; left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: .2s; }
.switch input:checked + .sl { background: var(--primary); }
.switch input:checked + .sl::before { transform: translateX(20px); }

/* ── 온보딩 ── */
.onboard { padding: 0 22px calc(18px + var(--safe-b)); overflow-y: auto; }
.ob-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 0 10px; position: sticky; top: 0; background: var(--bg); z-index: 2; }
.brand { display: flex; align-items: center; gap: 8px; font-size: 16px; }
.brand span { font-size: 22px; }
.auto-join { margin: auto; display: flex; flex-direction: column; align-items: center; gap: 16px; color: var(--text-2); font-size: 15px; }
.auto-join .spin { width: 38px; height: 38px; border-radius: 50%; border: 4px solid var(--surface-2); border-top-color: var(--primary); animation: ob-spin .9s linear infinite; }
@keyframes ob-spin { to { transform: rotate(360deg); } }
.ob-join { flex-direction: column; gap: 8px; }
.consent-line { font-size: 13px; color: var(--text-2); line-height: 1.55; }
.ob-join .advanced { margin-top: 0; }
.btn-link { background: none; border: 0; color: var(--muted); font-size: 14px; padding: 8px; text-decoration: underline; font-family: inherit; }
.ob-installs:empty { display: none; }
.ob-step { display: flex; flex-direction: column; padding-top: 14px; min-height: calc(100% - 60px); }
.ob-step h1 { font-size: 25px; letter-spacing: -.02em; margin-bottom: 8px; }
.ob-actions { margin-top: auto; padding-top: 24px; display: flex; gap: 10px; }
.ob-actions .btn-ghost { width: 34%; }
.code-input { text-transform: uppercase; letter-spacing: .4em; font-weight: 800; text-align: center; font-size: 26px; padding: 16px; }
.project-card { margin-top: 2px; background: var(--surface); border: 1px solid #10b98160; border-radius: 14px; padding: 14px; font-size: 14px; line-height: 1.6; }
.project-card b { font-size: 18px; display: block; }
.project-card .meta { color: var(--muted); font-size: 13px; }
.resume { margin: 14px 0 4px; background: linear-gradient(135deg, #1e3a8a55, #0f766e40); border: 1px solid #60a5fa66; border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
.resume .who { font-size: 14px; color: var(--text-2); line-height: 1.5; }
.gps-find { margin-top: 14px; border-color: #60a5fa66; color: var(--text); font-weight: 700; }
.nearby { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
.nearby .card { width: 100%; text-align: left; --c: #10b981; }
.nearby .card.far { --c: var(--line); opacity: .6; }
.nearby .note { font-size: 13px; color: var(--muted); line-height: 1.55; }
.resume .who b { color: var(--text); font-size: 16px; }
.roles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.role { padding: 16px 10px; border-radius: 14px; border: 2px solid var(--line); background: var(--surface); text-align: center; }
.role .ic { font-size: 32px; display: block; }
.role b { display: block; font-size: 16px; margin-top: 4px; }
.role small { color: var(--muted); font-size: 12.5px; }
.role.on { border-color: #60a5fa; background: #1e3a8a50; }
.equip-list { display: flex; flex-direction: column; gap: 8px; }
.equip-opt { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface); text-align: left; }
.equip-opt .ic { font-size: 24px; }
.equip-opt b { display: block; font-size: 15.5px; }
.equip-opt small { color: var(--muted); font-size: 12.5px; }
.equip-opt.on { border-color: #f59e0b; background: #78350f40; }
.equip-opt.taken { opacity: .55; }
.perm-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-top: 16px; }
.perm-list li { display: flex; gap: 12px; background: var(--surface); border-radius: 12px; padding: 12px 14px; }
.perm-list .pi { font-size: 22px; }
.perm-list b { display: block; font-size: 15px; }
.perm-list span { font-size: 13.5px; color: var(--text-2); line-height: 1.5; }
.advanced { margin-top: 14px; font-size: 14px; color: var(--muted); }
.advanced summary { cursor: pointer; padding: 6px 0; }

/* ── 메인: 앱 바 · 상태 ── */
.main { display: flex; flex-direction: column; }
.appbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: calc(8px + env(safe-area-inset-top)) 14px 8px; background: var(--surface); border-bottom: 1px solid var(--line); }
.ab-title { display: flex; flex-direction: column; min-width: 0; }
.ab-title b { font-size: 15.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ab-title small { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ab-ind { display: flex; gap: 6px; flex-shrink: 0; }
.ind { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; background: var(--surface-2); font-size: 11.5px; color: var(--text-2); }
.ind i { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
.ind.ok i { background: var(--ok); } .ind.warn i { background: var(--warn); } .ind.bad i { background: var(--danger); animation: blink 1s infinite; }
@keyframes blink { 50% { opacity: .3; } }

.status { padding: 12px 16px 11px; background: color-mix(in srgb, var(--lv) 22%, #0b1120); border-bottom: 3px solid var(--lv); transition: background .3s; }
.status .lv { font-size: 24px; font-weight: 900; letter-spacing: -.02em; line-height: 1.2; }
.status .msg { font-size: 15px; margin-top: 3px; line-height: 1.45; }
.status .src { font-size: 12.5px; color: rgba(255,255,255,.78); margin-top: 2px; }
.status .src:empty { display: none; }
.status.alarm { animation: flash .8s infinite; }
@keyframes flash { 50% { background: color-mix(in srgb, var(--lv) 55%, #0b1120); } }

/* ── 내용 영역 ── */
.content { flex: 1; position: relative; min-height: 0; }
.tab-pane { position: absolute; inset: 0; }
.map-pane #map { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; }
.map-chip { position: absolute; left: 10px; top: 10px; right: 64px; background: rgba(30,58,138,.92); border: 1px solid #60a5fa; padding: 7px 11px; border-radius: 10px; font-size: 13px; }
.map-tools { position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
.map-tools button { width: 44px; height: 44px; border-radius: 12px; border: 1px solid var(--line); background: rgba(17,26,46,.94); font-size: 19px; box-shadow: 0 4px 14px rgba(0,0,0,.35); }
.map-tools button[data-label] { width: 56px; height: 54px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; line-height: 1; font-size: 18px; }
.map-tools button[data-label]::after { content: attr(data-label); font-size: 10px; font-weight: 700; color: var(--muted); letter-spacing: -0.3px; white-space: nowrap; }
.intr { position: absolute; left: 10px; right: 92px; bottom: 12px; background: rgba(17,26,46,.95); border: 1px solid var(--line); border-radius: 12px; padding: 9px 11px; font-size: 13.5px; display: flex; flex-direction: column; gap: 3px; }
.attr { position: absolute; left: 8px; bottom: 3px; font-size: 9.5px; color: rgba(255,255,255,.7); text-shadow: 0 0 3px #000; pointer-events: none; }

.list-pane { overflow-y: auto; padding: 0 14px calc(100px + var(--safe-b)); }
.pane-head { padding: 16px 2px 6px; }
.pane-head h2 { font-size: 21px; }
.pane-head p { font-size: 13px; color: var(--muted); margin-top: 2px; }
.section-title { font-size: 12.5px; font-weight: 700; color: var(--muted); margin: 16px 2px 8px; letter-spacing: .03em; }
.cards { display: flex; flex-direction: column; gap: 8px; }
.card { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--c, var(--line)); border-radius: 12px; padding: 11px 12px; }
.card .ic { font-size: 22px; width: 30px; text-align: center; }
.card .body { flex: 1; min-width: 0; }
.card .body b { display: block; font-size: 15px; }
.card .body small { display: block; font-size: 12.5px; color: var(--muted); line-height: 1.45; }
.card .dist { font-size: 15px; font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
.card .dist small { display: block; font-size: 11px; color: var(--muted); font-weight: 400; }
.card.alert-danger { background: #ef44441c; } .card.alert-warning { background: #f9731614; }
.empty { text-align: center; color: var(--muted); font-size: 14px; padding: 28px 10px; border: 1px dashed var(--line); border-radius: 12px; line-height: 1.6; }

.me-card { display: flex; gap: 12px; align-items: center; background: var(--surface); border-radius: 14px; padding: 14px; margin-top: 4px; }
.me-card .ic { font-size: 34px; }
.me-card b { font-size: 17px; display: block; }
.me-card small { color: var(--muted); font-size: 13px; display: block; line-height: 1.5; }
.menu { background: var(--surface); border-radius: 14px; overflow: hidden; }
.menu-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; text-align: left; padding: 13px 14px; border: none; background: none; cursor: pointer; }
.menu-row + .menu-row { border-top: 1px solid var(--line); }
.menu-row b { display: block; font-size: 15px; font-weight: 600; }
.menu-row small { display: block; font-size: 12.5px; color: var(--muted); margin-top: 1px; }
.chev { color: var(--muted); font-size: 22px; }
.gps-info { background: var(--surface); border-radius: 14px; padding: 12px 14px; font-size: 13.5px; color: var(--text-2); line-height: 1.75; font-variant-numeric: tabular-nums; }
.btn-leave { width: 100%; margin-top: 18px; padding: 14px; border-radius: 14px; border: 1px solid #ef444466; background: #ef444418; color: #fca5a5; font-size: 15.5px; font-weight: 700; }
.foot { text-align: center; font-size: 12px; color: var(--muted); margin-top: 14px; }

/* ── SOS ── */
.sos-fab {
  --p: 0; position: absolute; right: 14px; bottom: 14px; width: 68px; height: 68px; border-radius: 50%; border: none; z-index: 20;
  background: conic-gradient(#fff calc(var(--p) * 1%), transparent 0) border-box, #dc2626;
  box-shadow: 0 6px 20px rgba(220,38,38,.55), inset 0 0 0 4px rgba(255,255,255,.18);
  color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; user-select: none; -webkit-user-select: none; touch-action: none;
}
.sos-fab::before { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: #dc2626; }
.sos-fab span, .sos-fab small { position: relative; }
.sos-fab span { font-size: 18px; font-weight: 900; letter-spacing: .04em; }
.sos-fab small { font-size: 10px; opacity: .85; }

/* ── 탭 바 ── */
.tabbar { display: flex; background: var(--surface); border-top: 1px solid var(--line); padding-bottom: var(--safe-b); }
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 8px 0 9px; border: none; background: none; color: var(--muted); font-size: 11.5px; font-weight: 600; position: relative; }
.tab .ti { font-size: 21px; filter: grayscale(.6); opacity: .8; }
.tab.on { color: #dbeafe; }
.tab.on .ti { filter: none; opacity: 1; }
.tab.on::before { content: ''; position: absolute; top: 0; left: 30%; right: 30%; height: 3px; border-radius: 0 0 3px 3px; background: #60a5fa; }
.tab-badge { position: absolute; top: 5px; left: 54%; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 9px; background: var(--danger); color: #fff; font-size: 10.5px; font-style: normal; font-weight: 800; display: flex; align-items: center; justify-content: center; }

/* ── 대화상자 · 시트 ── */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,.78); display: flex; align-items: center; justify-content: center; padding: 18px; z-index: 50; }
.dialog { background: var(--surface); border: 2px solid #60a5fa; border-radius: 18px; padding: 22px; width: 100%; max-width: 440px; display: flex; flex-direction: column; gap: 14px; }
.overlay.evacuate .dialog { border-color: #ef4444; background: #3b0d0d; animation: flash2 .7s infinite; }
@keyframes flash2 { 50% { background: #7f1d1d; } }
.dialog h2 { font-size: 21px; }
.dialog p { font-size: 18px; line-height: 1.55; white-space: pre-line; }
.sheet-wrap { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 40; display: flex; align-items: flex-end; justify-content: center; }
.sheet { width: 100%; max-width: 560px; background: var(--surface); border-radius: 20px 20px 0 0; padding: 10px 18px calc(18px + var(--safe-b)); display: flex; flex-direction: column; gap: 12px; max-height: 88vh; overflow-y: auto; animation: up .2s ease-out; }
@keyframes up { from { transform: translateY(30px); opacity: .6; } }
.grip { width: 40px; height: 5px; border-radius: 3px; background: var(--line); margin: 0 auto 4px; }
.sheet h2 { font-size: 19px; }
.sheet .menu-row { background: var(--surface-2); border-radius: 12px; }
.survey-stat { font-size: 15px; line-height: 1.7; background: #0d1526; border-radius: 10px; padding: 10px 12px; font-variant-numeric: tabular-nums; }
.bar { height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden; }
.bar i { display: block; height: 100%; background: #22d3ee; width: 0; transition: width .3s; }
.heading-row { display: flex; gap: 10px; align-items: center; font-size: 14px; color: var(--text-2); }
.heading-row input { flex: 1; }
.choice { display: flex; flex-direction: column; gap: 8px; }
.choice button { padding: 14px; border-radius: 12px; border: 2px solid var(--line); background: var(--surface-2); text-align: left; font-size: 15.5px; }
.choice button.on { border-color: #60a5fa; background: #1e3a8a50; }

/* ── v14: 근로자 앱 — 설치 · 설정 잠금 · 안전 경로 ── */
.brand img { width: 26px; height: 26px; border-radius: 7px; }
.install-card { display: flex; gap: 12px; align-items: center; width: 100%; margin-top: 14px; padding: 12px 14px; border-radius: 14px; border: 1px dashed #f59e0b88; background: #f59e0b14; text-align: left; }
a.install-card, a.menu-row { color: inherit; text-decoration: none; }
.install-card .ic { font-size: 26px; }
.install-card b { display: block; font-size: 15px; }
.install-card small { display: block; font-size: 12.5px; color: var(--muted); line-height: 1.45; }
.menu-row.locked { cursor: default; background: #10b98112; }
.menu-row.locked b { color: #6ee7b7; }
.map-tools button { width: 46px; height: 42px; }
.map-tools button[data-label] { width: 56px; height: 52px; }
.route-fab { position: absolute; left: 12px; bottom: 14px; z-index: 15; display: flex; align-items: center; gap: 7px; padding: 0 18px; height: 52px; border-radius: 26px; border: none; background: var(--primary); color: #fff; font-size: 16px; font-weight: 800; box-shadow: 0 6px 18px rgba(37,99,235,.5); }
.route-fab span { font-size: 20px; }
.route-card { position: absolute; left: 10px; right: 92px; bottom: 12px; z-index: 15; background: rgba(17,26,46,.96); border: 1px solid #3b82f6; border-radius: 14px; padding: 9px 11px; display: flex; flex-direction: column; gap: 3px; box-shadow: 0 8px 24px rgba(0,0,0,.45); }
.route-card.evac { border-color: #ef4444; background: rgba(59,13,13,.96); }
.rc-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13.5px; color: var(--text-2); }
.rc-head b { color: var(--text); }
.rc-x { width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface-2); flex-shrink: 0; font-size: 15px; }
.rc-main { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.rc-main b { font-size: 24px; font-weight: 900; font-variant-numeric: tabular-nums; }
.rc-main span { font-size: 14px; color: var(--text-2); }
.rc-main .rc-risk { font-size: 12.5px; font-weight: 700; }
.route-card small { font-size: 12.5px; color: var(--muted); line-height: 1.45; }
.route-card small.warn { color: #fdba74; }
.dest-list button { display: flex; align-items: center; gap: 12px; }
.dest-ic { font-size: 22px; }
.dest-b b { display: block; font-size: 15.5px; }
.dest-b small { display: block; font-size: 12.5px; color: var(--muted); margin-top: 1px; }

/* 2026-11-22 현장 운영 */
.ind-floor { border: 1px solid var(--line); font-weight: 700; color: var(--text); cursor: pointer; }
.opbar { display: flex; gap: 6px; padding: 8px 10px; background: #0b1120; border-bottom: 1px solid var(--line); }
.opbar button { flex: 1; height: 44px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface-2); color: var(--text-2); font-size: 14px; font-weight: 700; }
.opbar button.on[data-op="work"] { background: #f59e0b; border-color: #f59e0b; color: #111; }
.opbar button.on[data-op="idle"] { background: #64748b; border-color: #94a3b8; color: #fff; }
.opbar button.on[data-op="travel"] { background: #ef4444; border-color: #ef4444; color: #fff; }
.opbar button.on[data-op="walk"] { background: #2563eb; border-color: #3b82f6; color: #fff; }
.opbar button { font-size: 13px; padding: 0 2px; white-space: nowrap; }
.evacbar { display: flex; align-items: center; gap: 10px; padding: 9px 12px; background: #7f1d1d; border-bottom: 2px solid #ef4444; font-weight: 800; font-size: 14.5px; }
.evacbar span { flex: 1; line-height: 1.35; }
.evacbar button { flex-shrink: 0; height: 42px; padding: 0 14px; border-radius: 12px; border: none; background: #10b981; color: #06281d; font-weight: 900; font-size: 14px; }
.evacbar.done { background: #064e3b; border-color: #10b981; }
.evacbar.done button { display: none; }
.fall-ov .dialog { border-color: #ef4444; background: #3b0d0d; animation: flash2 .7s infinite; text-align: center; }
.fall-count { font-size: 34px; color: #fca5a5; }
.fall-ok { height: 64px; font-size: 22px; background: #10b981 !important; color: #06281d !important; }
.floor-choice { display: grid !important; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.floor-choice button { height: 48px; padding: 0 !important; justify-content: center; font-weight: 800; }
.floor-choice button.wide { grid-column: span 4; }
