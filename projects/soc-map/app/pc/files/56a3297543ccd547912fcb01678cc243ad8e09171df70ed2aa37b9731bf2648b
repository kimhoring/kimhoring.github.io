  if (isDriving(c)) return `🚜 ${esc(eqLabel(c.equipment))}${OP_STATES[c.op_state] ? ` · ${OP_STATES[c.op_state].label}` : ''}${(c.intrusions || []).length ? ` · <b class="d">반경 내 ${c.intrusions.length}명</b>` : ''}${c.speed ? ` · ${(c.speed * 3.6).toFixed(1)}km/h` : ''}`;
  return `${c.role === 'operator' ? `🚶 하차 · 도보 (${esc(eqLabel(c.equipment))} 정지) · ` : ''}${c.inside_site === false ? '현장 밖' : lv.label}${c.floor != null ? ` · ${floorText(c.floor)}` : ''}${c.nearest_m != null && c.level !== 'danger' ? ` · 위험구역 ${c.nearest_m}m` : ''}${c.source && (c.level === 'danger' || c.level === 'warning') ? ` · ${esc(c.source)}` : ''}`;
}
function renderPeople() {
