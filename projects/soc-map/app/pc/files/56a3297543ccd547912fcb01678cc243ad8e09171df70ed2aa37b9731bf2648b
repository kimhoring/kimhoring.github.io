$('msgSend').addEventListener('click', () => sendMsg($('msgText').value.trim(), 'info'));
// 대피 지시는 실수로 누르지 않도록 1.2초 길게 누르기
(() => {
  const btn = $('evacHold'); let t = null, t0 = 0;
  const up = () => { clearInterval(t); t = null; btn.style.setProperty('--p', 0); };
  btn.addEventListener('pointerdown', e => {
    e.preventDefault(); t0 = Date.now();
    t = setInterval(() => {
      const p = Math.min(1, (Date.now() - t0) / 1200); btn.style.setProperty('--p', p * 100);
      if (p >= 1) { up(); vibrate([100, 50, 100]); sendMsg('🚨 즉시 작업을 중지하고 지정된 대피 장소로 이동하세요.', 'evacuate'); }
    }, 30);
  });
  btn.addEventListener('pointerup', up); btn.addEventListener('pointerleave', up); btn.addEventListener('contextmenu', e => e.preventDefault());
})();

// ── 대피 장소 추가 ──
