  $('surveyStat').textContent = '지점에 휴대폰을 대고 「측정 시작」을 누르세요.';
  $('surveyBar').style.width = '0'; $('surveySend').hidden = true; $('surveyStart').hidden = false;
  $('surveySheet').hidden = false;
