/* ═══════════════════════════════════════════════════════════════
 *  SOC-MAP v14 — 관리감독자 앱 (휴대폰, /supervisor · 설치형 웹앱)
 *
 *  관리자 PC(/map)와 같은 관리자 WebSocket 으로 현장 인원 위치·경보를 실시간으로 받는다.
 *  - 지도: 근로자·장비 운전원 실시간 위치(GPS), 장비 위험 반경, 대피 장소, 위험 진입자 깜박임
 *  - 알림: 위험 구역 진입·신호 끊김 → 앱 알림 배너 + 짧은 알림음 + 휴대폰 알림(Web Push)
 *          근로자 SOS → 어디서 일어났는지(건물·장비·대피 장소 기준 위치 설명) 전체 화면 + 너무 크지 않은 사이렌
 *  - 지시: 개별 메시지 · 전체 알림 · 전체 대피(근로자 앱이 대피 장소까지 안전 경로 안내)
 *  - 근로자 앱 정책(경보음 잠금 · 시연 모드 허용 · GPS 합류), 대피 장소 관리, 근로자 합류 QR, GPS 측량
 *  로그인: 관리자 키 (PC 화면 QR 의 #p=…&k=… 또는 직접 입력). 키는 이 휴대폰에만 저장
 * ═══════════════════════════════════════════════════════════════ */
'use strict';

const $ = (id) => document.getElementById(id);
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const LS = {
  get(k, d) { try { const v = localStorage.getItem(k); return v === null ? d : v; } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, v); } catch (e) { /* noop */ } },
  del(k) { try { localStorage.removeItem(k); } catch (e) { /* noop */ } },
};
const fmtM = (m) => (m == null ? '-' : m >= 1000 ? `${(m / 1000).toFixed(1)}km` : m >= 10 ? `${Math.round(m)}m` : `${m.toFixed(1)}m`);
const timeStr = (ts) => new Date(ts * 1000).toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
const ago = (ts) => { const s = Math.max(0, Math.round(Date.now() / 1000 - ts)); return s < 60 ? `${s}초 전` : s < 3600 ? `${Math.floor(s / 60)}분 전` : `${Math.floor(s / 3600)}시간 전`; };

// basemap.js · sitemap.js 가 쓰는 전역
const S = { layers: { basemap: LS.get('socmap.sv.basemap', 'satellite') } };
let DPR = window.devicePixelRatio || 1;
let _frame = null, _drawQueued = false;
function getFrame() { return _frame; }
function requestRender() { if (!_drawQueued) { _drawQueued = true; requestAnimationFrame(() => { _drawQueued = false; draw(); }); } }

const SV = {
  pid: null, key: null, meta: null, site: null, planImg: null, contourPolys: [], markers: [], field: null,
  clients: new Map(), events: [], places: [], policy: {}, survey: [],
  ws: null, connected: false, retry: 0,
  tab: 'map', focusId: null, sheetId: null, msgTo: 'all',
  me: null, meOn: LS.get('socmap.sv.me', '0') === '1', meWatch: null,
  sound: LS.get('socmap.sv.sound', '1') === '1', vibe: LS.get('socmap.sv.vibe', '1') === '1', wake: LS.get('socmap.sv.wake', '1') === '1',
  audio: null, wakeLock: null, sirenTimer: null, alarmEv: null, unread: 0,
  pickPlace: false, placeAt: null, placeKind: 'assembly', survey_: null, push: false,
};
const swReady = PWA.register();

// 관리자 키 — 이 휴대폰에만. 같은 주소의 PC 화면(/map)에 저장된 키도 함께 찾는다
const Keys = {
  all() { try { return JSON.parse(LS.get('socmap.sv.keys', '{}')); } catch (e) { return {}; } },
  get(pid) { try { return this.all()[pid] || JSON.parse(LS.get('socmap.v13.keys', '{}'))[pid] || null; } catch (e) { return null; } },
  set(pid, key) { const a = this.all(); a[pid] = key; LS.set('socmap.sv.keys', JSON.stringify(a)); },
  del(pid) { const a = this.all(); delete a[pid]; LS.set('socmap.sv.keys', JSON.stringify(a)); },
};

async function api(path, { method = 'GET', body } = {}) {
  const headers = { 'X-Manager-Key': SV.key || '' };
  if (body !== undefined) headers['Content-Type'] = 'application/json';
  const r = await fetch(path, { method, headers, body: body !== undefined ? JSON.stringify(body) : undefined, cache: 'no-store' });
  const d = (r.headers.get('content-type') || '').includes('json') ? await r.json() : null;
  if (!r.ok) throw new Error(r.status === 403 ? '관리자 키가 올바르지 않습니다.' : (d && d.detail) || `HTTP ${r.status}`);
  return d;
}

