function sortedClients() {
  return [...SV.clients.values()].sort((a, b) => (b.online !== false) - (a.online !== false)
    || LEVELS[b.level || 'safe'].rank - LEVELS[a.level || 'safe'].rank || String(a.name).localeCompare(b.name));
}
function eqLabel(id) { return (SV.markers.find(m => m.id === id) || {}).label || '장비 미지정'; }
function clientDetail(c) {
  const off = c.online === false, lv = LEVELS[c.level || 'safe'];
