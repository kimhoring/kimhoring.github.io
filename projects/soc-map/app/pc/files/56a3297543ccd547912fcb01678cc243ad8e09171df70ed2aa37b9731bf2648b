let _chosenPid = null;
async function loadProjectList() {
  try {
    const list = await (await fetch('/api/projects', { cache: 'no-store' })).json();
    $('prjList').innerHTML = list.length ? list.map(p => `<button class="card prj-pick" data-pid="${esc(p.id)}" style="--c:#3b82f6">
        <span class="ic">🏗️</span><span class="body"><b>${esc(p.name)}</b><small>접속 ${p.online}명 · ${new Date(p.created_at * 1000).toLocaleDateString('ko-KR')}${Keys.get(p.id) ? ' · 🔑 저장된 키' : ''}</small></span></button>`).join('')
      : '<div class="empty">서버에 현장이 없습니다. 관리자 PC에서 「새 프로젝트」를 만드세요.</div>';
    const last = LS.get('socmap.sv.last', '');
    if (list.some(p => p.id === last)) pickProject(last);
  } catch (e) { $('prjList').innerHTML = '<div class="empty">서버에 연결할 수 없습니다.</div>'; }
}
function pickProject(pid) {
  _chosenPid = pid;
  document.querySelectorAll('.prj-pick').forEach(b => b.classList.toggle('on', b.dataset.pid === pid));
  $('keyInput').value = Keys.get(pid) || '';
  $('loginBtn').disabled = !$('keyInput').value.trim();
}
$('prjList').addEventListener('click', e => { const b = e.target.closest('[data-pid]'); if (b) pickProject(b.dataset.pid); });
$('keyInput').addEventListener('input', () => { $('loginBtn').disabled = !(_chosenPid && $('keyInput').value.trim()); });
$('loginBtn').addEventListener('click', async () => {
  $('loginErr').textContent = ''; unlockAudio();
  try { await login(_chosenPid, $('keyInput').value.trim()); } catch (e) { $('loginErr').textContent = e.message; }
});

// v14.10 서버 주소가 바뀌면 이 저장 공간도 새로 시작되므로 안드로이드 앱이 기억한 로그인을 먼저 채운다
{ const p = PWA.profile(); if (p.pid && p.key) { Keys.set(p.pid, p.key); LS.set('socmap.sv.last', p.pid); } }

async function login(pid, key) {
  SV.pid = pid; SV.key = key;
  let meta;
  try { meta = await api(`/api/projects/${pid}`); } catch (e) { SV.pid = SV.key = null; throw e; }
  if (!meta.join_code) { SV.pid = SV.key = null; throw new Error('관리자 키가 올바르지 않습니다.'); }
  SV.meta = meta; SV.policy = meta.policy || {};
  Keys.set(pid, key); LS.set('socmap.sv.last', pid); PWA.saveProfile({ pid, key });
  _frame = new LocalFrame(meta.origin.lat, meta.origin.lon);
  await loadSite();
  $('login').hidden = true; $('main').hidden = false;
  $('abProject').textContent = meta.name;
  SV.clients = new Map(); SV.events = []; SV.unread = 0;
  connect();
  if (SV.meOn) startMe();
  keepAwake();
  PWA.keepAlive(true, `${meta.name} · 관제 중 (위험 진입·SOS 알림)`);
  setTab('map'); renderAll();
  syncPush();
  loadWeather();
}

function logout(reason) {
  PWA.saveProfile({});
  if (SV.ws) { SV.ws.onclose = null; try { SV.ws.close(); } catch (e) { /* noop */ } }
  SV.ws = null; SV.connected = false; SV.pid = null; SV.key = null;
  stopMe(); stopSiren(); hideAlarm();
  if (SV.wakeLock) SV.wakeLock.release().catch(() => {});
  PWA.keepAlive(false);
  setWeather(null);
  $('main').hidden = true; $('login').hidden = false;
  if (reason) $('loginErr').textContent = reason;
  loadProjectList();
}
$('logoutBtn').addEventListener('click', () => { if (confirm('로그아웃할까요? 이 휴대폰으로 경보를 받지 않게 됩니다.')) logout(); });

/** 현장 배치 (관리자 PC가 공유한 도면·건물·장비) */
async function loadSite() {
  try {
    const site = await api(`/api/projects/${SV.pid}/site`);
    SV.site = site;
    SV.markers = site.doc.markers || [];
    SV.contourPolys = (site.doc.contours || []).map(flattenContour);
    if (site.places) SV.places = site.places;
    if (site.planVersion && site.phonePlan) {
      const img = new Image();
      img.onload = () => { SV.planImg = img; requestRender(); };
      img.src = `/api/projects/${SV.pid}/plan?v=${site.planVersion}&code=${encodeURIComponent(SV.meta.join_code)}`;
    } else SV.planImg = null;
  } catch (e) { SV.site = null; SV.markers = []; SV.contourPolys = []; }
  rebuildLive();
  requestRender();
}

/** 운전원 휴대폰 위치 = 장비 실시간 위치 → 위험 반경 */
function rebuildLive() {
  if (!SV.site) { SV.field = null; return; }
  const ops = [...SV.clients.values()].filter(c => c.role === 'operator' && c.online !== false && c.x != null);
  const markers = SV.markers.map(m => {
    const op = ops.find(c => c.equipment === m.id);
    if (!op) return m;
    const P = equipPoseOf(op, m);   // 2026-11-25 도보면 장비는 마지막 자리에 정지, 작업 중이면 위험 구역은 작업 위치에 고정
    return { ...m, x: P.x, y: P.y, heading: P.heading, _live: true, _by: op.name, _plan: { x: m.x, y: m.y }, _workAt: P.workAt, _liveState: op.op_state, _v: P.v };
  });
  SV.field = new RiskField(markers, SV.site.doc.siteEnvironment || { windSpeed: 0, envZones: [] });
}

function siteExtent() {
  if (SV.site && SV.site.extent) return SV.site.extent;
  const pts = [...SV.clients.values()].filter(c => c.x != null);
  if (!pts.length) return { minX: -100, minY: -100, maxX: 100, maxY: 100, w: 200, h: 200 };
  const xs = pts.map(c => c.x), ys = pts.map(c => c.y);
  const minX = Math.min(...xs) - 40, maxX = Math.max(...xs) + 40, minY = Math.min(...ys) - 40, maxY = Math.max(...ys) + 40;
  return { minX, minY, maxX, maxY, w: maxX - minX, h: maxY - minY };
}

// ═══════════════════════════════════════════════
//  실시간 연결
// ═══════════════════════════════════════════════

function connect() {
  const ws = new WebSocket(`${location.protocol === 'https:' ? 'wss' : 'ws'}://${location.host}/ws/p/${SV.pid}/manager?key=${encodeURIComponent(SV.key)}`);
  SV.ws = ws;
  ws.onopen = () => { if (SV.retry > 0) toast('서버 연결이 복구되었습니다.', 'ok'); SV.connected = true; SV.retry = 0; renderStatus(); };
  ws.onmessage = (e) => { if (SV.ws === ws) onMessage(JSON.parse(e.data)); };
  ws.onclose = (e) => {
    if (SV.ws !== ws) return;
    const was = SV.connected;
    SV.connected = false; renderStatus();
    if (e.code === 4403) { logout('관리자 키가 거부되었습니다. 키를 다시 확인하세요.'); return; }
    if (was) { toast('서버 연결이 끊겼습니다. 자동으로 다시 연결합니다.', 'warn'); vibrate([300, 100, 300]); }
    if (SV.pid) setTimeout(() => { if (SV.pid && SV.ws === ws) connect(); }, Math.min(10000, 1000 * 2 ** SV.retry++));
    if (SV.retry >= 2) followServer();
  };
  ws.onerror = () => ws.close();
}

// v14.10 노트북을 다시 켜 주소가 바뀌면 안내판을 보고 저절로 따라간다
let _followTimer = null;
function followServer() {
  if (_followTimer || !Directory.enabled()) return;
  _followTimer = setInterval(async () => {
    if (!SV.pid || SV.connected) { clearInterval(_followTimer); _followTimer = null; return; }
    const url = await Directory.find();
    if (!url || url === location.origin || !SV.pid || SV.connected) return;
    PWA.open(`${url}/supervisor#p=${encodeURIComponent(SV.pid)}&k=${encodeURIComponent(SV.key)}`);
  }, 10000);
}

function onMessage(m) {
  switch (m.type) {
    case 'snapshot':
      SV.clients = new Map(m.clients.map(c => [c.id, c]));
      SV.events = m.events.slice().reverse();
      SV.places = m.places || SV.places; SV.policy = m.policy || SV.policy; SV.survey = m.survey || [];
      SV.evac = m.evac || null; SV.corr = m.corr || null;
      rebuildLive(); renderPolicy(); renderPlaces();
      if (m.weather) setWeather(m.weather);
      if (SV.pendingEv) { const ev = SV.events.find(x => x.id === SV.pendingEv); SV.pendingEv = null; if (ev) setTimeout(() => openEvent(ev), 300); }
      break;
    case 'client':
      SV.clients.set(m.client.id, m.client);
      if (m.client.role === 'operator') rebuildLive();
      if (SV.sheetId === m.client.id) renderPerson();
      break;
    case 'left': SV.clients.delete(m.id); rebuildLive(); break;
    case 'event':
      SV.events.unshift(m.event); SV.events = SV.events.slice(0, 200);
      onEvent(m.event);
      break;
    case 'ack':
      for (const ev of SV.events) if (ev.id === m.event_id) ev.acked = true;
      if (SV.alarmEv && SV.alarmEv.id === m.event_id) nextAlarm();
      break;
    case 'places': SV.places = m.places || []; renderPlaces(); break;
    case 'policy': SV.policy = m.policy || {}; renderPolicy(); break;
    case 'evac': SV.evac = m.evac || null; break;
    case 'corr': SV.corr = m.corr || null; renderRef(); break;
    case 'weather': setWeather(m.weather); break;
    case 'site': loadSite(); toast('관리자 PC가 현장 배치를 갱신했습니다.'); break;
    case 'survey': SV.survey = m.survey || []; break;
  }
  renderStatus(); renderBadges(); renderEvac();
  if (SV.tab === 'people') renderPeople();
  if (SV.tab === 'alerts') renderEvents();
  requestRender();
}

const NOTIF_ICON = '/app/pwa/icons/supervisor-192.png';
/** 알림 단계: SOS = 위치와 함께 전체 화면 + 사이렌(작게), 그 밖의 긴급 = 앱 알림 배너 + 알림음, 접근 경고 = 소리 없는 토스트 */
function onEvent(ev) {
  // 안드로이드 앱에서는 「휴대폰 알림」을 끈 경우 알림을 띄우지 않는다 (웹은 알림 권한이 있을 때만 표시됨)
  const hidden = document.hidden && (SV.push || !PWA.native), url = `/supervisor#ev=${ev.id}`;
  if (ev.kind === 'sos') {
    showAlarm(ev);
    if (hidden) PWA.notify(`🆘 긴급 호출 — ${ev.name || '근로자'}`, { body: ev.location ? `📍 ${ev.location}` : ev.text, tag: ev.id, renotify: true, requireInteraction: true, vibrate: [400, 150, 400, 150, 400], icon: NOTIF_ICON, data: { url, event_id: ev.id } });
  } else if (ev.severity === 'critical') {
    notifyBanner(ev); chime(); vibrate([120, 60, 120]);
    if (hidden) PWA.notify(`SOC-MAP · ${SV.meta.name}`, { body: ev.text, tag: ev.id, vibrate: [150, 80, 150], icon: NOTIF_ICON, data: { url, event_id: ev.id } });
  } else if (ev.severity === 'warning') {
    toast(ev.text, 'warn');
  }
  if (SV.tab !== 'alerts' && ev.severity !== 'info') SV.unread++;
}

/** 휴대폰 상단 알림처럼 내려오는 배너 — 누르면 지도에서 그 위치 */
function notifyBanner(ev) {
  const el = document.createElement('button');
  el.className = 'toast notif';
  const title = { enter: '위험 구역 진입', offline: '신호 끊김' }[ev.kind] || '안전 알림';
  el.innerHTML = `<img src="${NOTIF_ICON}" alt=""><span><b>${esc(title)}</b><small>${esc(String(ev.text).replace(/^\S+\s/, ''))}</small></span><time>${timeStr(ev.ts).slice(0, 5)}</time>`;
  el.onclick = () => { el.remove(); focusEvent(ev); };
  $('toasts').appendChild(el);
  setTimeout(() => el.classList.add('out'), 6000);
  setTimeout(() => el.remove(), 6500);
}
function focusEvent(ev) {
  setTab('map');
  if (ev && ev.x != null) { SV.focusId = ev.client_id; map.centerOn(ev.x, ev.y, map.fitScale(siteExtent()) * 2.5); }
}
/** 휴대폰 알림을 눌러 들어왔을 때: 확인 안 한 SOS 면 경보 화면, 아니면 지도에서 위치 */
function openEvent(ev) { if (ev.kind === 'sos' && !ev.acked) showAlarm(ev); else focusEvent(ev); }

// ── SOS 경보 화면 ──
function unackedCritical() { return SV.events.filter(e => e.severity === 'critical' && !e.acked); }
function unackedSos() { return SV.events.filter(e => e.kind === 'sos' && !e.acked); }
function showAlarm(ev) {
  SV.alarmEv = ev;
  $('alarmTitle').textContent = `🆘 긴급 호출 — ${ev.name || '근로자'}`;
  $('alarmText').textContent = ev.location ? `📍 ${ev.location}` : ev.x != null ? '📍 지도에서 위치를 확인하세요' : '📍 위치 정보 없음 (근로자 휴대폰이 GPS를 아직 못 잡음)';
  const more = unackedSos().length - 1;
  $('alarmMeta').textContent = [timeStr(ev.ts), ev.acc >= 1 ? `위치 오차 ±${Math.round(ev.acc)} m` : '', ev.fix_age > 15 ? `마지막 위치 ${ev.fix_age}초 전` : '',
    more > 0 ? `확인 안 한 긴급 호출 ${more}건 더` : ''].filter(Boolean).join(' · ');
  $('alarmLocate').hidden = ev.x == null;
  $('alarmOv').hidden = false;
  if (SV.sirenFor !== ev.id) { SV.sirenFor = ev.id; siren(); }
  requestRender();
}
function hideAlarm() { $('alarmOv').hidden = true; SV.alarmEv = null; SV.sirenFor = null; stopSiren(); }
function nextAlarm() { const left = unackedSos(); if (left.length) showAlarm(left[0]); else hideAlarm(); }
function ack(ev) { if (!ev || ev.acked) return; ev.acked = true; wsSend({ type: 'ack', event_id: ev.id }); }
$('alarmAck').addEventListener('click', () => { ack(SV.alarmEv); nextAlarm(); renderStatus(); renderBadges(); if (SV.tab === 'alerts') renderEvents(); });
$('alarmLocate').addEventListener('click', () => {
  const ev = SV.alarmEv; ack(ev); hideAlarm();
  setTab('map');
  if (ev && ev.x != null) { SV.focusId = ev.client_id; map.centerOn(ev.x, ev.y, map.fitScale(siteExtent()) * 2.5); }
  renderStatus(); renderBadges();
});
navigator.serviceWorker && navigator.serviceWorker.addEventListener('message', e => {   // 휴대폰 알림을 눌러 들어온 경우
  if (e.data && e.data.type === 'notification-click') { const ev = SV.events.find(x => x.id === e.data.event_id); if (ev) openEvent(ev); }
});

function wsSend(obj) {
  if (SV.ws && SV.ws.readyState === 1) { SV.ws.send(JSON.stringify(obj)); return true; }
  toast('서버에 연결되어 있지 않습니다.', 'err');
  return false;
}

// ═══════════════════════════════════════════════
//  화면 렌더
// ═══════════════════════════════════════════════

function counts() {
  const on = [...SV.clients.values()].filter(c => c.online !== false);
  const workers = on.filter(c => !isDriving(c));   // 장비에서 내린 운전원은 작업자
  return { workers: workers.length, ops: on.length - workers.length,
    warn: workers.filter(c => c.level === 'warning').length, danger: workers.filter(c => c.level === 'danger').length,
    off: [...SV.clients.values()].filter(c => c.online === false).length, crit: unackedCritical().length, sos: unackedSos().length };
}
function renderStatus() {
  const k = counts(), el = $('status');
  const color = !SV.connected ? '#64748b' : k.sos || k.danger || k.crit ? '#ef4444' : k.warn ? '#f97316' : '#10b981';
  el.style.setProperty('--lv', color);
  el.classList.toggle('alarm', !!k.sos);   // 깜박임은 확인 안 한 SOS 만
  $('lvText').textContent = !SV.connected ? '📵 서버 연결 중…' : k.sos ? `🆘 긴급 호출 ${k.sos}건 — 확인하세요` : k.danger ? `🚨 위험 구역 진입 ${k.danger}명`
