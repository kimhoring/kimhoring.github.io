$('surveyStart').addEventListener('click', () => {
  if (!SV.me) { $('surveyStat').textContent = 'GPS 신호를 기다리는 중입니다. 잠시 후 다시 시도하세요.'; return; }
  SV.survey_ = { running: true, samples: [], start: Date.now() };
  $('surveyStart').hidden = true;
  const DUR = 60000;
  const timer = setInterval(() => {
    const sv = SV.survey_; if (!sv) { clearInterval(timer); return; }
    const t = Date.now() - sv.start, r = averageFixes(sv.samples);
    $('surveyBar').style.width = Math.min(100, t / DUR * 100) + '%';
    $('surveyStat').innerHTML = r ? `측정 ${r.n}회 · 흩어짐 ${r.spread.toFixed(1)}m<br>추정 오차 <b>±${r.estError.toFixed(1)}m</b><br>${r.lat.toFixed(7)}, ${r.lon.toFixed(7)}` : `측정 중… (${Math.round(t / 1000)}초)`;
    if (t >= DUR || !sv.running) {
      clearInterval(timer); sv.running = false; sv.result = r;
      if (r) { $('surveySend').hidden = false; beep(1320, 0.15); vibrate(200); }
      else { $('surveyStat').textContent = '정확한 측위(±30m 이내)를 얻지 못했습니다. 하늘이 트인 곳에서 다시 시도하세요.'; $('surveyStart').hidden = false; }
