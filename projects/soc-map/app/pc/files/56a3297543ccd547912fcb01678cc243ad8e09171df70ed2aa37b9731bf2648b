// ── 메시지 · 전체 알림 · 대피 지시 ──
const QUICK_ALL = ['장비 작업 시작 — 반경 접근 금지', '양중 작업 중 — 하부 통행 금지', '휴식 시간입니다', '작업 종료 — 현장 정리'];
const QUICK_ONE = ['위험 구역에서 즉시 벗어나세요.', '장비 작업을 일시 중지하세요.', '관리감독자에게 연락하세요.', '확인했습니다.'];
function openMsg(to = 'all') {
  SV.msgTo = to;
  const c = to === 'all' ? null : SV.clients.get(to);
  $('msgTitle').textContent = c ? `💬 ${c.name}에게` : '📢 전체 알림';
  $('evacLabel').textContent = c ? `🚨 ${c.name} 즉시 대피` : '🚨 전체 대피 지시';
  $('msgText').value = '';
  $('msgQuick').innerHTML = (c ? QUICK_ONE : QUICK_ALL).map(q => `<button data-q="${esc(q)}">${esc(q)}</button>`).join('');
  $('msgSheet').hidden = false;
}
$('bcBtn').addEventListener('click', () => openMsg('all'));
$('msgQuick').addEventListener('click', e => { const b = e.target.closest('[data-q]'); if (b) $('msgText').value = b.dataset.q; });
function sendMsg(text, level) {
  if (!text) { toast('보낼 내용을 입력하세요.', 'warn'); return; }
  if (wsSend({ type: 'message', to: SV.msgTo, text, level })) {
    $('msgSheet').hidden = true;
    toast(SV.msgTo === 'all' ? '전체 인원에게 보냈습니다.' : '보냈습니다.', 'ok');
