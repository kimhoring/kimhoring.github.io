function setChip() {
  const t = SV.pickPlace ? '📍 대피 장소·목적지로 쓸 지점을 누르세요' : '';
  $('chip').textContent = t; $('chip').hidden = !t;
}
function onMapTap(w, sp) {
  if (SV.pickPlace) { openPlace(w); return; }
  const people = [...SV.clients.values()].filter(c => c.x != null);
  const c = map.hit(people, sp);
  if (c) { SV.focusId = c.id; openPerson(c.id); requestRender(); return; }
  const p = map.hit(SV.places, sp);
  if (p) { toast(`${p.kind === 'assembly' ? '🟢 대피 장소' : '📍 목적지'} — ${p.name}`); return; }
  SV.focusId = null; requestRender();
}

function draw() {
  if ($('main').hidden || SV.tab !== 'map' || !_frame) return;
  if (!map._sized && !map.resize()) return;
  map.frame(siteExtent(), null);
  const vis = map.begin();
  map.basemap(vis);
  $('attr').textContent = Basemap.attribution();
  if (SV.site) { map.plan(SV.planImg, SV.site.phonePlan, 0.7); map.siteLayers(SV.site, SV.contourPolys); }
  if (SV.field) map.equipment(SV.field);
  map.places(SV.places);
  if (SV.placeAt) map.emoji('📍', SV.placeAt.x, SV.placeAt.y - map.px(10), 26);
  for (const ev of unackedSos()) if (ev.x != null) map.sos(ev.x, ev.y, `SOS ${ev.name || ''}`);
  let danger = 0;
  for (const c of SV.clients.values()) {
    if (c.x == null || isDriving(c)) continue;
    const off = c.online === false, hot = !off && c.level === 'danger', walkOp = c.role === 'operator';
    if (hot) danger++;
    map.person(c.x, c.y, { color: off ? '#64748b' : LEVELS[c.level || 'safe'].color, label: c.name + (walkOp ? ' (운전원·도보)' : '') + (off ? ' (끊김)' : ''), labelColor: off ? '#cbd5e1' : '#fff',
      pulse: hot, sigma: c.sim ? 0 : c.sigma, focus: c.id === SV.focusId, emoji: walkOp ? '🚶' : '👷' });
  }
  if (SV.me) map.person(SV.me.x, SV.me.y, { color: '#2563eb', label: '나', me: true, sigma: SV.me.acc, emoji: '🦺' });
  map.end();
  map.scale(26);
  $('legend').innerHTML = SV.site ? '' : '<span>관리자 PC가 현장 배치를 아직 공유하지 않았습니다 — 인원 위치만 표시합니다.</span>';
  $('legend').hidden = !!SV.site;
}
setInterval(() => {
  if (unackedSos().some(e => e.x != null)) { requestRender(); return; }
  for (const c of SV.clients.values()) if (c.level === 'danger' && c.online !== false) { requestRender(); break; }
}, 60);

// ── 내 위치 (관리감독자 휴대폰 GPS — 서버로 보내지 않음) ──
function startMe() {
  if (SV.meWatch !== null || !PWA.geoOk() || !_frame) return;
  SV.meWatch = navigator.geolocation.watchPosition(p => {
    const loc = _frame.toLocal(p.coords.latitude, p.coords.longitude);
    SV.me = { x: loc.x, y: loc.y, acc: p.coords.accuracy, lat: p.coords.latitude, lon: p.coords.longitude };
    if (SV.ref) wsSend({ type: 'ref_fix', place: SV.ref, lat: p.coords.latitude, lon: p.coords.longitude, acc: p.coords.accuracy, by: deviceLabel() });
    if (SV.survey_ && SV.survey_.running) SV.survey_.samples.push({ lat: p.coords.latitude, lon: p.coords.longitude, acc: p.coords.accuracy });
    requestRender();
  }, err => { if (err.code === 1) toast('위치 권한이 거부되었습니다. 브라우저 설정에서 허용하세요.', 'err'); }, { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 });
}
function stopMe() { if (SV.meWatch !== null) navigator.geolocation.clearWatch(SV.meWatch); SV.meWatch = null; SV.me = null; }
function setMe(on) { SV.meOn = on; LS.set('socmap.sv.me', on ? '1' : '0'); if (on) startMe(); else stopMe(); renderMore(); requestRender(); }
$('meToggle').addEventListener('change', e => setMe(e.target.checked));

// ═══════════════════════════════════════════════
//  경보음 · 진동 · 화면 켜두기
// ═══════════════════════════════════════════════

function unlockAudio() { try { SV.audio = SV.audio || new (window.AudioContext || window.webkitAudioContext)(); SV.audio.resume(); } catch (e) { SV.audio = null; } }
document.addEventListener('pointerdown', unlockAudio, { once: true });
/** 부드러운 사인파 한 음 (앱 알림음 크기) */
function beep(freq, dur, when = 0, vol = 0.12) {
  if (!SV.sound || !SV.audio) return;
  const t = SV.audio.currentTime + when, o = SV.audio.createOscillator(), g = SV.audio.createGain();
  o.type = 'sine'; o.frequency.setValueAtTime(freq, t);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(vol, t + 0.015); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
  o.connect(g).connect(SV.audio.destination); o.start(t); o.stop(t + dur + 0.02);
}
function vibrate(p) { if (!SV.vibe) return; try { navigator.vibrate && navigator.vibrate(p); } catch (e) { /* noop */ } }
/** 앱 알림음: 띵-동 두 음 */
function chime() { beep(988, 0.16); beep(1319, 0.24, 0.14); }
/** SOS 사이렌 한 번(약 2.8초): 700↔1050 Hz 로 오르내리는 사인파, 음량은 경보음보다 작게(0.16) */
function sirenOnce() {
  if (!SV.sound || !SV.audio) return;
  const a = SV.audio, t = a.currentTime, o = a.createOscillator(), g = a.createGain();
  o.type = 'sine';
  for (let i = 0; i < 4; i++) {
    o.frequency.setValueAtTime(700, t + i * 0.7); o.frequency.linearRampToValueAtTime(1050, t + i * 0.7 + 0.35); o.frequency.linearRampToValueAtTime(700, t + i * 0.7 + 0.7);
  }
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.16, t + 0.12); g.gain.setValueAtTime(0.16, t + 2.6); g.gain.exponentialRampToValueAtTime(0.0001, t + 2.8);
  o.connect(g).connect(a.destination); o.start(t); o.stop(t + 2.85);
}
/** SOS: 확인할 때까지 5초마다 사이렌(최대 2분) */
function siren() {
  stopSiren(); sirenOnce(); vibrate([400, 150, 400, 150, 400]);
  const t0 = Date.now();
  SV.sirenTimer = setInterval(() => { if (Date.now() - t0 > 120000) stopSiren(); else { sirenOnce(); vibrate([300, 150, 300]); } }, 5000);
}
function stopSiren() { clearInterval(SV.sirenTimer); SV.sirenTimer = null; }
async function keepAwake() { if (!SV.wake) return; try { if ('wakeLock' in navigator) SV.wakeLock = await navigator.wakeLock.request('screen'); } catch (e) { /* 미지원 */ } }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible' && SV.pid) { keepAwake(); if (SV.ws && SV.ws.readyState > 1) connect(); } });

$('soundToggle').addEventListener('change', e => { SV.sound = e.target.checked; LS.set('socmap.sv.sound', SV.sound ? '1' : '0'); unlockAudio(); });
$('vibeToggle').addEventListener('change', e => { SV.vibe = e.target.checked; LS.set('socmap.sv.vibe', SV.vibe ? '1' : '0'); });
$('wakeToggle').addEventListener('change', e => {
  SV.wake = e.target.checked; LS.set('socmap.sv.wake', SV.wake ? '1' : '0');
  if (SV.wake) keepAwake(); else if (SV.wakeLock) { SV.wakeLock.release().catch(() => {}); SV.wakeLock = null; }
});
$('testBtn').addEventListener('click', async () => {
  unlockAudio(); chime(); vibrate([120, 60, 120]);
  setTimeout(sirenOnce, 900);   // SOS 사이렌 크기도 들려 준다
  const shown = await PWA.notify('SOC-MAP 알림 시험', { body: '위험 구역 진입·SOS가 이렇게 표시됩니다.', tag: 'test', icon: '/app/pwa/icons/supervisor-192.png' });
  if (SV.push) {
    const sub = PWA.reg && await PWA.reg.pushManager.getSubscription();
    if (sub) { try { await api(`/api/projects/${SV.pid}/push/test`, { method: 'POST', body: { endpoint: sub.endpoint } }); toast('서버에서 휴대폰 알림을 보냈습니다. 몇 초 안에 도착합니다.', 'ok'); } catch (e) { toast('푸시 시험 실패: ' + e.message, 'err'); } }
  } else if (!shown) toast('휴대폰 알림이 꺼져 있습니다. 「휴대폰 알림」을 켜세요.', 'warn');
});

// ═══════════════════════════════════════════════
//  휴대폰 알림 (Web Push) — 앱을 닫아도 긴급 경보 수신
// ═══════════════════════════════════════════════

const b64uToBytes = (s) => { const b = atob((s + '='.repeat((4 - s.length % 4) % 4)).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from(b, c => c.charCodeAt(0)); };
function pushUnavailableReason() {
  if (PWA.native) return '';   // 안드로이드 앱: 앱이 살아 있으므로 서버 푸시 없이 앱이 직접 알림
  if (PWA.state() === 'insecure') return '정식 인증서 주소(https://…trycloudflare.com)에서만 됩니다. 관리자 PC 서버를 「--tunnel」로 켜고 그 주소의 QR로 다시 접속하세요.';
  if (!('PushManager' in window)) return PWA.state() === 'ios' ? 'iPhone은 홈 화면에 설치한 앱(iOS 16.4 이상)에서만 알림을 받을 수 있습니다.' : '이 브라우저는 휴대폰 알림을 지원하지 않습니다.';
  return '';
}
async function syncPush() {
  await swReady;
  if (PWA.native) {
    SV.push = LS.get('socmap.sv.appNotify', '1') === '1' && PWA.notifyPermission() === 'granted';
    $('pushHint').textContent = '화면이 꺼져 있어도 위험 진입·SOS를 휴대폰 알림으로';
    $('pushToggle').disabled = false;
    renderStatus(); renderMore();
    return;
  }
  const why = pushUnavailableReason();
  $('pushHint').textContent = why || '앱을 닫아도 위험 진입·SOS 알림';
  $('pushToggle').disabled = !!why;
  SV.push = false;
  if (!why && PWA.reg) {
    const sub = await PWA.reg.pushManager.getSubscription().catch(() => null);
    if (sub && Notification.permission === 'granted') {
      try { await api(`/api/projects/${SV.pid}/push`, { method: 'POST', body: { subscription: sub.toJSON(), label: deviceLabel() } }); SV.push = true; } catch (e) { /* noop */ }
    }
  }
  renderStatus(); renderMore();
}
function deviceLabel() { const m = navigator.userAgent.match(/\(([^;)]+);?\s*([^;)]*)/); return `관리감독자 휴대폰${m ? ` (${(m[2] || m[1]).slice(0, 24)})` : ''}`; }
$('pushToggle').addEventListener('change', async e => {
  const on = e.target.checked;
  if (PWA.native) {
    if (on && await PWA.requestNotify() !== 'granted') {
      SV.push = false;
      toast('알림 권한이 꺼져 있습니다. 휴대폰 설정 → 앱 → SOC 관리감독 → 알림에서 허용하세요.', 'err');
    } else {
      SV.push = on; LS.set('socmap.sv.appNotify', on ? '1' : '0');
      toast(on ? '휴대폰 알림을 켰습니다. 「알림 시험」으로 확인하세요.' : '휴대폰 알림을 껐습니다.', on ? 'ok' : undefined);
    }
    renderStatus(); renderMore();
    return;
  }
  try {
    await swReady;
    if (on) {
      const why = pushUnavailableReason(); if (why) throw new Error(why);
      if (await Notification.requestPermission() !== 'granted') throw new Error('알림 권한이 거부되었습니다. 브라우저 설정 → 사이트 설정에서 알림을 허용하세요.');
      const { key } = await (await fetch('/api/push/key')).json();
      const sub = await PWA.reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64uToBytes(key) });
      await api(`/api/projects/${SV.pid}/push`, { method: 'POST', body: { subscription: sub.toJSON(), label: deviceLabel() } });
      SV.push = true; toast('휴대폰 알림을 켰습니다. 「알림 시험」으로 확인하세요.', 'ok');
    } else {
      const sub = PWA.reg && await PWA.reg.pushManager.getSubscription();
      if (sub) { await api(`/api/projects/${SV.pid}/push/remove`, { method: 'POST', body: { endpoint: sub.endpoint } }).catch(() => {}); await sub.unsubscribe(); }
      SV.push = false; toast('휴대폰 알림을 껐습니다.');
    }
  } catch (err) { SV.push = !on ? SV.push : false; toast(err.message, 'err'); }
  renderStatus(); renderMore();
});

