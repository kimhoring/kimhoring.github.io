$('placeKind').addEventListener('click', e => { const b = e.target.closest('[data-kind]'); if (!b) return; SV.placeKind = b.dataset.kind; document.querySelectorAll('#placeKind button').forEach(x => x.classList.toggle('on', x === b)); });
$('placeSave').addEventListener('click', async () => {
