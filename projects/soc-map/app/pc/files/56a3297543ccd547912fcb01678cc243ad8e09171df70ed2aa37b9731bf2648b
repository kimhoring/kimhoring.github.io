// ═══════════════════════════════════════════════
//  시작: PC 화면 QR(#p=…&k=…) → 저장된 키 → 직접 로그인
// ═══════════════════════════════════════════════

/** 주소의 #p=…&k=… 로 로그인. 키가 주소창·방문 기록에 남지 않게 먼저 지운다 */
async function hashLogin(h) {
  history.replaceState(null, '', location.pathname);
  try { await login(h.get('p'), h.get('k')); return true; } catch (e) { $('loginErr').textContent = e.message; return false; }
}
// v14.9 이 화면이 열린 채로 같은 주소의 QR 을 열면 # 뒤만 바뀌어 페이지가 다시 불리지 않는다
window.addEventListener('hashchange', async () => {
  const h = new URLSearchParams(location.hash.slice(1));
  if (!h.get('p') || !h.get('k')) return;
  if (SV.pid) logout();
  if (!(await hashLogin(h))) loadProjectList();
});

(async () => {
  const h = new URLSearchParams(location.hash.slice(1));
  SV.pendingEv = h.get('ev');   // 휴대폰 알림을 눌러 앱이 새로 열린 경우 그 경보로
  if (SV.pendingEv && !h.get('k')) history.replaceState(null, '', location.pathname);
  if (h.get('p') && h.get('k')) {
    if (await hashLogin(h)) return;
  } else {
    const last = LS.get('socmap.sv.last', ''), key = last && Keys.get(last);
    if (key) { try { await login(last, key); return; } catch (e) { $('loginErr').textContent = e.message; } }
  }
  loadProjectList();
})();

// ═══════════════════════════════════════════════
//  기상청 날씨 (v14.5) — 서버가 현장 위치로 받아 10분마다 보내 준다(WebSocket 'weather').
//  법정 작업 중지 기준 판정도 서버(weather.py)가 하고, 새로 넘으면 경보 기록(주의)으로도 온다.
// ═══════════════════════════════════════════════
const WX_ST = { ok: '정상', info: '참고', caution: '주의', warn: '예보', stop: '중지' };
async function loadWeather() {
  try { setWeather(await api(`/api/projects/${SV.pid}/weather`)); } catch (e) { /* 키 없음(503) 등 — 날씨 표시 없이 동작 */ }
}
function setWeather(w) {
  SV.weather = w || null;
  renderWeather();
}
function renderWeather() {
  const w = SV.weather, ind = $('indWx');
  $('wxSection').hidden = ind.hidden = !w;
  if (!w) return;
  const n = w.now, hr = (iso) => `${new Date(iso).getHours()}시`;
  ind.className = 'ind ' + (w.level === 'stop' ? 'bad' : w.level === 'warn' || w.level === 'caution' ? 'warn' : 'ok');
  ind.querySelector('span').textContent = `🌬️ ${n.gust_est == null ? '-' : n.gust_est}m/s`;
  $('wxMeta').textContent = `${hr(n.time)} 관측 · 격자 ${w.grid.nx},${w.grid.ny}`;
  const bad = w.checks.filter(c => c.status !== 'ok');
  $('wxBox').innerHTML = `
    <div class="now">🌡️ <b>${n.temp ?? '-'}℃</b>${n.feels_like != null && n.feels_like !== n.temp ? ` (체감 ${n.feels_like}℃)` : ''} · 💧 ${n.humidity ?? '-'}% · 강수 <b>${esc(n.rain_text)}</b><br>
      🌬️ 평균 <b>${n.wind ?? '-'} m/s</b> → 순간 추정 <b>${n.gust_est ?? '-'} m/s</b> <small>(× ${w.gust_factor}, 장비 풍속계 우선)</small></div>
    ${bad.map(c => `<div class="wx-row st-${c.status}"><span class="st">${WX_ST[c.status]}</span><span>${esc(c.text)}${c.status === 'warn' && c.peak_time ? ` — ${hr(c.peak_time)} 최대 ${c.peak6h}${c.unit}` : ''}<small>${esc(c.law)}${c.note ? ` · ${esc(c.note)}` : ''}</small></span></div>`).join('')
    || `<div class="wx-ok">✅ 타워크레인(제37조) · 철골작업(제383조) 기상 중지 기준에 해당 없음 · ${w.missing && w.missing.length ? (w.hours && w.hours.length ? '일부 예보만 반영' : '지금 날씨 기준 (예보는 받지 못함)') : '6시간 예보 포함'}</div>`}
    ${w.missing && w.missing.length ? `<div class="wx-ok">⚠️ 받지 못한 예보: ${w.missing.map(m => esc(m.label)).join(' · ')}</div>` : ''}`;
}


