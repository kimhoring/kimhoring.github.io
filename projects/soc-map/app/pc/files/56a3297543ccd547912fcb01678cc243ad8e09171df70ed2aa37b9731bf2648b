const map = new SiteMap($('map'), { onTap: onMapTap, onLongPress: (w) => openPlace(w) });
window.addEventListener('resize', () => { if (map.resize()) requestRender(); });
$('fitBtn').addEventListener('click', () => { map.setMode('fit'); requestRender(); });
