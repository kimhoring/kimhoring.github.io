// ── 작업자 상세 ──
function openPerson(cid) { SV.sheetId = cid; renderPerson(); $('personSheet').hidden = false; }
function renderPerson() {
  const c = SV.clients.get(SV.sheetId);
  if (!c) { $('personSheet').hidden = true; SV.sheetId = null; return; }
  const off = c.online === false, lv = LEVELS[c.level || 'safe'];
  const rows = [
    ['상태', off ? `신호 끊김 (${ago(c.last_seen)})` : isDriving(c) ? `장비 운전 중${OP_STATES[c.op_state] ? ` · ${OP_STATES[c.op_state].label}` : ''}` : c.role === 'operator' ? `하차 · 도보 — ${lv.label}` : lv.label],
