  $('personMsg').disabled = off;
  $('personLocate').disabled = c.x == null;
}
$('personMsg').addEventListener('click', () => { const id = SV.sheetId; $('personSheet').hidden = true; openMsg(id); });
$('personLocate').addEventListener('click', () => {
  const c = SV.clients.get(SV.sheetId); $('personSheet').hidden = true;
