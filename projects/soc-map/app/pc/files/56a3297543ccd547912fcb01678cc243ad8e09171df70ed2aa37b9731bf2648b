      <span class="ic">${c.role === 'operator' ? '🚜' : '👷'}</span><div><h2>${esc(c.name)}${c.sim ? ' <em>시연</em>' : ''}</h2><small>${c.role === 'operator' ? '장비 운전원' : '작업자'}</small></div></div>
