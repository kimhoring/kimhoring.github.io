function mmss(s) { s = Math.max(0, Math.round(s)); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; }
function renderEvac() {
  const el = $('svEvac'), ev = SV.evac;
  if (!ev || SV.evacHidden === ev.id) { el.hidden = true; return; }
  const ps = (ev.people || []).map(p => { const c = SV.clients.get(p.id); return { ...p, online: !!c && c.online !== false }; });
  const arrived = ps.filter(p => p.state === 'arrived').length, rest = ps.filter(p => p.state !== 'arrived');
  const lost = rest.filter(p => !p.online);
  el.hidden = false; el.classList.toggle('ended', !!ev.ended);
  el.innerHTML = `<div class="se-head"><b>${ev.ended ? '🏁 대피 종료' : '🚨 대피 점호'}</b><span>${ev.ended ? `${mmss(ev.ended - ev.start)} 걸림` : `<span data-evac-clock="${ev.start}">${mmss(Date.now() / 1000 - ev.start)}</span> 경과`}</span></div>
    <div class="se-nums"><span class="ok">도착 <b>${arrived}</b>/${ps.length}</span><span>이동 중 <b>${rest.length - lost.length}</b></span><span class="bad">연락 없음 <b>${lost.length}</b></span></div>
    ${rest.length ? `<div class="se-list">${rest.map(p => `<button data-evac-p="${esc(p.id)}" class="${p.online ? '' : 'lost'}">${esc(p.name)}</button>`).join('')}</div>` : ''}
    ${ev.ended ? '<button class="se-btn" data-evac-close>닫기</button>' : `<button class="se-btn end" data-evac-end>${rest.length ? '대피 종료' : '✅ 전원 도착 — 대피 종료'}</button>`}`;
}
$('svEvac').addEventListener('click', e => {
  const t = e.target, ev = SV.evac;
  if (t.closest('[data-evac-end]')) {
    const rest = ev ? ev.people.filter(p => p.state !== 'arrived') : [];
    if (rest.length && !confirm(`아직 확인되지 않은 인원 ${rest.length}명 (${rest.map(p => p.name).join(', ')}).\n대피를 끝내고 기록에 남길까요?`)) return;
    wsSend({ type: 'evac_end' });
  } else if (t.closest('[data-evac-p]')) {
    const id = t.closest('[data-evac-p]').dataset.evacP, p = ev && ev.people.find(q => q.id === id);
    if (!p) return;
    if (confirm(`${p.name} — 무전·대면으로 안전을 확인했나요?\n(취소를 누르면 지도에서 위치를 봅니다)`)) wsSend({ type: 'evac_safe', id });
    else openPerson(id);
  } else if (t.closest('[data-evac-close]')) { SV.evacHidden = ev && ev.id; renderEvac(); }
});
setInterval(() => {
  document.querySelectorAll('[data-evac-clock]').forEach(el => { el.textContent = mmss(Date.now() / 1000 - +el.dataset.evacClock); });
}, 1000);

// 기준점 보정: 이 휴대폰을 기준점 위에 두고 GPS 를 계속 보냄
function renderRef() {
  const refs = SV.places.filter(p => p.kind === 'ref');
  $('refChoice').innerHTML = refs.length ? refs.map(p => `<button data-ref="${esc(p.id)}" class="${SV.ref === p.id ? 'on' : ''}">📡 ${esc(p.name)}</button>`).join('')
    : '<p class="lead">등록된 기준점이 없습니다. 관리자 PC → 관제 → 대피 장소 「＋ 지도에서 추가」에서 이름 앞에 @ 를 붙여 만드세요.</p>';
  const k = SV.corr, fresh = k && Date.now() / 1000 - k.at < 15;
  $('refStat').textContent = !SV.ref ? '' : fresh
    ? `보정 중 — GPS 오차 동 ${k.dx >= 0 ? '+' : ''}${k.dx.toFixed(1)} m · 남 ${k.dy >= 0 ? '+' : ''}${k.dy.toFixed(1)} m (보고 ${k.n}번)${SV.policy.ref_corr === false ? ' · 근로자 앱 적용은 꺼져 있음' : ''}`
    : 'GPS 를 모으는 중… (정확도 15 m 안의 측정이 5번 모이면 시작)';
  $('refStop').hidden = !SV.ref;
  $('refHint').textContent = SV.ref ? `켜짐 — ${(refs.find(p => p.id === SV.ref) || {}).name || ''} 위에 두세요` : '위치를 아는 기준점에 이 휴대폰을 두면 근로자 휴대폰의 GPS 오차를 줄입니다';
}
$('refBtn').addEventListener('click', () => { renderRef(); $('refSheet').hidden = false; });
$('refChoice').addEventListener('click', e => {
  const b = e.target.closest('[data-ref]'); if (!b) return;
  SV.ref = b.dataset.ref;
  if (!SV.meOn) setMe(true); else startMe();
  keepAwake();
  renderRef();
});
$('refStop').addEventListener('click', () => { SV.ref = null; renderRef(); });
