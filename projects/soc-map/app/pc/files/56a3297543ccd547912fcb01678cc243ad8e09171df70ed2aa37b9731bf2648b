    c.source ? ['원인', esc(c.source)] : null,
    ['위치 정확도', c.sigma != null ? `±${c.sigma.toFixed(1)} m${c.acc ? ` (GPS ±${Math.round(c.acc)} m)` : ''}` : '-'],
    ['이동 속도', c.speed != null ? `${(c.speed * 3.6).toFixed(1)} km/h` : '-'],
